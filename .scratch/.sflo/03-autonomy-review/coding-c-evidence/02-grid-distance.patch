+from collections import deque
+
 def identity(payload):
- return payload['value']
+    return payload['value']
+
+def shortest_path(grid, start, end):
+    rows = len(grid)
+    if start == end and grid[start[0]][start[1]] != '#':
+        return 0
+    if grid[start[0]][start[1]] == '#' or grid[end[0]][end[1]] == '#':
+        return None
+    cols = len(grid[0])
+    start_node = (start[0], start[1])
+    end_node = (end[0], end[1])
+    distances = {start_node: 0}
+    queue = deque([start_node])
+    while queue:
+        row, col = queue.popleft()
+        distance = distances[(row, col)]
+        for drow, dcol in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nrow, ncol = row + drow, col + dcol
+            if 0 <= nrow < rows and 0 <= ncol < cols and grid[nrow][ncol] != '#':
+                node = (nrow, ncol)
+                if node == end_node:
+                    return distance + 1
+                if node not in distances:
+                    distances[node] = distance + 1
+                    queue.append(node)
+    return None
+
+def action_distance(payload):
+    return shortest_path(payload['grid'], payload['start'], payload['end'])
