@@ -0,0 +1,43 @@
+import unittest
+from api import dispatch
+
+class ActionDistanceTests(unittest.TestCase):
+    def test_normal_path_around_wall(self):
+        payload = {
+            "action": "action_distance",
+            "grid": ["...", ".#.", "..."],
+            "start": [0, 0],
+            "end": [2, 2],
+        }
+        self.assertEqual(dispatch(payload), 4)
+
+    def test_boundary_blocked_start_end_identical(self):
+        payload = {
+            "action": "action_distance",
+            "grid": ["#"],
+            "start": [0, 0],
+            "end": [0, 0],
+        }
+        self.assertIsNone(dispatch(payload))
+
+    def test_boundary_unreachable_and_input_not_mutated(self):
+        grid = ["..#", "###", "..#"]
+        payload = {
+            "action": "action_distance",
+            "grid": grid,
+            "start": [0, 0],
+            "end": [2, 0],
+        }
+        self.assertIsNone(dispatch(payload))
+        self.assertEqual(grid, ["..#", "###", "..#"])
+
+    def test_identity_still_works_and_unknown_action_rejected(self):
+        self.assertEqual(
+            dispatch({"action": "identity", "value": {"anything": [1, None]}}),
+            {"anything": [1, None]},
+        )
+        with self.assertRaises(ValueError):
+            dispatch({"action": "nope", "value": 1})
+
+if __name__ == "__main__":
+    unittest.main()
