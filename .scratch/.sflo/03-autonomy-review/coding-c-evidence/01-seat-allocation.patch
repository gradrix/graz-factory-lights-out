+from fractions import Fraction
+
 def identity(payload):
- return payload['value']
+    return payload['value']
+
+def allocate(payload):
+    weights = list(payload['weights'])
+    seats = payload['seats']
+    total = sum(weights)
+    if total == 0:
+        if seats != 0:
+            raise ValueError("cannot allocate positive seats with zero total weight")
+        return [0] * len(weights)
+    quotas = [Fraction(seats * w, total) for w in weights]
+    result = [q.numerator // q.denominator for q in quotas]
+    remaining = seats - sum(result)
+    order = sorted(range(len(weights)), key=lambda i: (quotas[i] - result[i], -i), reverse=True)
+    for i in order[:remaining]:
+        result[i] += 1
+    return result
