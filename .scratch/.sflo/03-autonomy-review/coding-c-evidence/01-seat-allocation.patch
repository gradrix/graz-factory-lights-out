@@ -0,0 +1,68 @@
+import unittest
+import json
+import subprocess
+
+from api import dispatch
+from domain import allocate
+
+
+class AllocateTests(unittest.TestCase):
+    def test_allocate_normal_largest_remainders(self):
+        # Exact quotas 10/3 = 3.333...; floors 3,3,3; equal remainders -> lower index wins.
+        self.assertEqual(dispatch({"action": "allocate", "weights": [1, 1, 1], "seats": 10}), [4, 3, 3])
+        # Quotas 3.75 and 1.25 -> floor 3,1; the remainder seat goes to the larger fraction.
+        self.assertEqual(dispatch({"action": "allocate", "weights": [3, 1], "seats": 5}), [4, 1])
+        # Tie on fractional remainder: quotas 1.5, 1.5 -> lower index gets the extra seat.
+        self.assertEqual(dispatch({"action": "allocate", "weights": [5, 5], "seats": 3}), [2, 1])
+
+    def test_allocate_boundaries(self):
+        # Zero seats always returns one zero per weight.
+        self.assertEqual(dispatch({"action": "allocate", "weights": [1, 2, 3], "seats": 0}), [0, 0, 0])
+        # Empty weights with seats=0 returns [].
+        self.assertEqual(dispatch({"action": "allocate", "weights": [], "seats": 0}), [])
+        # All-zero weights with seats=0 returns one zero per weight.
+        self.assertEqual(dispatch({"action": "allocate", "weights": [0, 0], "seats": 0}), [0, 0])
+        # Maximum seats bound.
+        self.assertEqual(dispatch({"action": "allocate", "weights": [1], "seats": 1000}), [1000])
+
+    def test_allocate_rejected_inputs(self):
+        # Positive seats with zero total weight raises ValueError.
+        with self.assertRaises(ValueError):
+            dispatch({"action": "allocate", "weights": [0, 0], "seats": 2})
+        # Unknown action raises ValueError.
+        with self.assertRaises(ValueError):
+            dispatch({"action": "nope", "value": 1})
+
+    def test_no_mutation_of_input(self):
+        payload = {"action": "allocate", "weights": [3, 1], "seats": 5}
+        result = dispatch(payload)
+        self.assertEqual(payload["weights"], [3, 1])
+        self.assertEqual(sum(result), 5)
+        # Identity preserves any JSON value and does not mutate it.
+        value = {"nested": [1, {"x": None}]}
+        self.assertEqual(dispatch({"action": "identity", "value": value}), value)
+
+    def test_cli_success_and_error(self):
+        proc = subprocess.run(
+            ["python", "cli.py"],
+            input=json.dumps({"action": "allocate", "weights": [2, 1], "seats": 4}),
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(json.loads(proc.stdout), [3, 1])
+        self.assertEqual(proc.stderr, "")
+        proc = subprocess.run(
+            ["python", "cli.py"],
+            input=json.dumps({"action": "allocate", "weights": [0], "seats": 3}),
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual(proc.returncode, 2)
+        self.assertNotEqual(proc.stderr.strip(), "")
+        self.assertNotIn("Traceback", proc.stderr)
+        self.assertEqual(proc.stdout, "")
+
+
+if __name__ == "__main__":
+    unittest.main()
