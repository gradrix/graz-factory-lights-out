@@ -0,0 +1,30 @@
+import unittest
+from api import dispatch
+
+class EvaluateTests(unittest.TestCase):
+    def test_normal_polynomial(self):
+        # 1 + 2x + 3x^2 at x=10 -> value 321, derivative 2 + 6*10 = 62
+        result = dispatch({"action": "evaluate", "coefficients": [1, 2, 3], "x": 10})
+        self.assertEqual(result, {"value": 321, "derivative": 62})
+
+    def test_empty_and_constant_boundaries(self):
+        # Empty polynomial is zero; constant has zero derivative.
+        self.assertEqual(dispatch({"action": "evaluate", "coefficients": [], "x": 7}),
+                         {"value": 0, "derivative": 0})
+        self.assertEqual(dispatch({"action": "evaluate", "coefficients": [-5], "x": -100}),
+                         {"value": -5, "derivative": 0})
+        # Boundary magnitude: 30 coefficients of 100 at x=100 (exact integers).
+        big = dispatch({"action": "evaluate", "coefficients": [100] * 30, "x": 100})
+        self.assertEqual(big["value"], sum(100 * 100 ** k for k in range(30)))
+        self.assertEqual(big["derivative"], sum(k * 100 * 100 ** (k - 1) for k in range(1, 30)))
+
+    def test_unknown_action_rejected(self):
+        with self.assertRaises(ValueError) as rejected:
+            dispatch({"action": "nope", "value": 1})
+        self.assertEqual(str(rejected.exception), "unknown action: nope")
+        # identity still works for any JSON value
+        self.assertEqual(dispatch({"action": "identity", "value": {"a": [1, None]}}),
+                         {"a": [1, None]})
+
+if __name__ == "__main__":
+    unittest.main()
