+import unittest
+from api import dispatch
+
+
+class OccurrencesNormal(unittest.TestCase):
+    def test_normal_month_walk(self):
+        result = dispatch({"action": "occurrences", "start": "2021-01-15", "day": 15, "count": 4})
+        self.assertEqual(result, ["2021-01-15", "2021-02-15", "2021-03-15", "2021-04-15"])
+
+    def test_identity_preserved_for_any_json_value(self):
+        for value in (None, True, 0, "", [], {"nested": [1, {"x": None}]}):
+            self.assertEqual(dispatch({"action": "identity", "value": value}), value)
+
+
+class OccurrencesBoundaries(unittest.TestCase):
+    def test_clamping_and_year_rollover(self):
+        # 31st absent in April/June -> last day of those months; February keeps 31st desired
+        # elsewhere; iteration crosses the year boundary.
+        result = dispatch({"action": "occurrences", "start": "2021-03-31", "day": 31, "count": 4})
+        self.assertEqual(result, ["2021-03-31", "2021-04-30", "2021-05-31", "2021-06-30"])
+
+    def test_february_leap_and_non_leap(self):
+        self.assertEqual(dispatch({"action": "occurrences", "start": "2024-02-01", "day": 29, "count": 3}),
+                         ["2024-02-29", "2024-03-29", "2024-04-29"])
+        self.assertEqual(dispatch({"action": "occurrences", "start": "2023-02-01", "day": 29, "count": 3}),
+                         ["2023-02-28", "2023-03-29", "2023-04-29"])
+
+    def test_omission_of_dates_before_start(self):
+        # start after the requested day: month's date omitted, next month used.
+        self.assertEqual(dispatch({"action": "occurrences", "start": "2020-05-20", "day": 1, "count": 2}),
+                         ["2020-06-01", "2020-07-01"])
+        # start on the last day of a shorter month: that month yields its own last day.
+        self.assertEqual(dispatch({"action": "occurrences", "start": "2021-04-30", "day": 31, "count": 2}),
+                         ["2021-04-30", "2021-05-31"])
+
+    def test_count_zero_and_year_bounds(self):
+        self.assertEqual(dispatch({"action": "occurrences", "start": "2000-01-01", "day": 31, "count": 0}), [])
+        self.assertEqual(dispatch({"action": "occurrences", "start": "2090-12-31", "day": 31, "count": 1}),
+                         ["2090-12-31"])
+
+
+class RejectedInputs(unittest.TestCase):
+    def test_unknown_action_raises_value_error(self):
+        with self.assertRaises(ValueError) as error:
+            dispatch({"action": "occurrences2", "start": "2021-01-01", "day": 1, "count": 1})
+        self.assertEqual(str(error.exception), "unknown action: occurrences2")
+
+    def test_input_never_mutated_even_on_failure(self):
+        payload = {"action": "nope", "value": {"deep": [1, 2]}}
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+        self.assertEqual(payload, {"action": "nope", "value": {"deep": [1, 2]}})
+        payload = {"action": "occurrences", "start": "2021-01-31", "day": 31, "count": 2}
+        result = dispatch(payload)
+        self.assertEqual(result, ["2021-01-31", "2021-02-28"])
+        self.assertEqual(payload, {"action": "occurrences", "start": "2021-01-31", "day": 31, "count": 2})
+
+
+if __name__ == "__main__":
+    unittest.main()
