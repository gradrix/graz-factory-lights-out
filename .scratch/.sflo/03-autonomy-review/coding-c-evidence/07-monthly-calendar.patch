+import calendar
+
+
 def identity(payload):
- return payload['value']
+    return payload['value']
+
+
+def occurrences(payload):
+    """Return count ISO dates on the requested day, clamped per month.
+
+    Starts with the month containing start; months whose clamped day falls
+    before start are omitted; iteration continues into later months until
+    count dates are produced. Each month clamps independently (a February
+    without the requested day never changes the desired day elsewhere).
+    """
+    start = payload['start']
+    day = payload['day']
+    count = payload['count']
+    results = []
+    year = int(start[0:4])
+    month = int(start[5:7])
+    while len(results) < count:
+        last = calendar.monthrange(year, month)[1]
+        current = day if day <= last else last
+        candidate = "%04d-%02d-%02d" % (year, month, current)
+        if candidate >= start:
+            results.append(candidate)
+        month += 1
+        if month > 12:
+            month = 1
+            year += 1
+    return results
