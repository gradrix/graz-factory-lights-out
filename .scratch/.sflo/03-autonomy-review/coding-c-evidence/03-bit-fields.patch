@@ -0,0 +1,77 @@
+import unittest
+import json
+import subprocess
+import sys
+import pathlib
+
+ROOT = pathlib.Path(__file__).resolve().parent.parent
+
+
+class PackUnpackTests(unittest.TestCase):
+    def test_pack_normal_and_empty(self):
+        from api import dispatch
+        # Normal: most significant field first.
+        result = dispatch({"action": "pack", "fields": [
+            {"width": 4, "value": 1},
+            {"width": 8, "value": 255},
+        ]})
+        self.assertEqual(result, {"value": 0x1FF, "bits": 12})
+        # Empty fields boundary.
+        self.assertEqual(dispatch({"action": "pack", "fields": []}),
+                         {"value": 0, "bits": 0})
+        # Boundary: max value for width 16.
+        self.assertEqual(dispatch({"action": "pack", "fields": [
+            {"width": 16, "value": 65535}]}), {"value": 65535, "bits": 16})
+        # Rejected: value >= 2**width or negative.
+        with self.assertRaises(ValueError):
+            dispatch({"action": "pack", "fields": [{"width": 4, "value": 16}]})
+        with self.assertRaises(ValueError):
+            dispatch({"action": "pack", "fields": [{"width": 4, "value": -1}]})
+
+    def test_unpack_normal_and_errors(self):
+        from api import dispatch
+        # Normal round trip.
+        values = dispatch({"action": "unpack", "widths": [4, 8], "value": 0x1FF})
+        self.assertEqual(values, [1, 255])
+        # Boundary: empty widths accept only zero.
+        self.assertEqual(dispatch({"action": "unpack", "widths": [], "value": 0}), [])
+        # Boundary: max value for total width.
+        self.assertEqual(dispatch({"action": "unpack", "widths": [16], "value": 65535}),
+                         [65535])
+        # Rejected: value too large, negative, or nonzero for empty widths.
+        with self.assertRaises(ValueError):
+            dispatch({"action": "unpack", "widths": [4], "value": 16})
+        with self.assertRaises(ValueError):
+            dispatch({"action": "unpack", "widths": [4], "value": -1})
+        with self.assertRaises(ValueError):
+            dispatch({"action": "unpack", "widths": [], "value": 1})
+
+    def test_identity_and_cli_errors(self):
+        from api import dispatch
+        # Identity preserved for any JSON value, including falsy ones.
+        for value in [None, False, 0, "", [], {"x": 1}]:
+            self.assertEqual(dispatch({"action": "identity", "value": value}), value)
+        # Unknown action raises ValueError.
+        with self.assertRaises(ValueError):
+            dispatch({"action": "nope"})
+        # CLI: ValueError -> exit 2, nonempty stderr, no traceback.
+        proc = subprocess.run([sys.executable, "cli.py"],
+                              input=json.dumps({"action": "pack",
+                                               "fields": [{"width": 4, "value": 99}]}),
+                              capture_output=True, text=True, cwd=ROOT)
+        self.assertEqual(proc.returncode, 2)
+        self.assertNotEqual(proc.stderr.strip(), "")
+        self.assertNotIn("Traceback", proc.stderr)
+        self.assertEqual(proc.stdout, "")
+        # CLI success: JSON in, JSON out, exit 0.
+        proc = subprocess.run([sys.executable, "cli.py"],
+                              input=json.dumps({"action": "unpack",
+                                               "widths": [4, 8], "value": 511}),
+                              capture_output=True, text=True, cwd=ROOT)
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(json.loads(proc.stdout), [1, 255])
+        self.assertEqual(proc.stderr, "")
+
+
+if __name__ == "__main__":
+    unittest.main()
