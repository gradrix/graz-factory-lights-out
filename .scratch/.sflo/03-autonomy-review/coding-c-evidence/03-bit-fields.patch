@@ -1,2 +1,30 @@
 def identity(payload):
- return payload['value']
+    return payload['value']
+
+def pack(payload):
+    fields = payload['fields']
+    value = 0
+    bits = 0
+    for field in fields:
+        width = field['width']
+        v = field['value']
+        if v < 0 or v >= 2 ** width:
+            raise ValueError("value out of range for width: %d" % width)
+        value = (value << width) | v
+        bits += width
+    return {'value': value, 'bits': bits}
+
+def unpack(payload):
+    widths = payload['widths']
+    value = payload['value']
+    total = 0
+    for width in widths:
+        total += width
+    if value < 0 or value >= 2 ** total:
+        raise ValueError("value out of range for total width: %d" % total)
+    values = []
+    for width in reversed(widths):
+        values.append(value & ((1 << width) - 1))
+        value >>= width
+    values.reverse()
+    return values
