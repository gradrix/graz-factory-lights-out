+import unittest
+from api import dispatch
+
+class CheckAction(unittest.TestCase):
+    def test_check_normal_and_boundary(self):
+        # Canonical Luhn example: valid; separators ignored; empty/all-separator
+        # inputs are the boundary and return False.
+        self.assertIs(dispatch({"action": "check", "number": "7992 781-2"}), True)
+        self.assertIs(dispatch({"action": "check", "number": "0000"}), True)
+        self.assertIs(dispatch({"action": "check", "number": "18"}), True)
+        self.assertIs(dispatch({"action": "check", "number": "0"}), True)
+        self.assertIs(dispatch({"action": "check", "number": "1"}), False)
+        self.assertIs(dispatch({"action": "check", "number": ""}), False)
+        self.assertIs(dispatch({"action": "check", "number": " -  - "}), False)
+
+    def test_append_normal_and_leading_zero(self):
+        # Check digit is unique and leading zeroes survive normalization.
+        self.assertEqual(dispatch({"action": "append", "number": "7992 781"}), "79927812")
+        self.assertEqual(dispatch({"action": "append", "number": "001234567890123"}), "0012345678901237")
+        self.assertEqual(dispatch({"action": "append", "number": "-0-0-0-"}), "0000")
+        self.assertEqual(dispatch({"action": "append", "number": "1"}), "18")
+        # Appended result always passes check.
+        for number in ("7992 781", "001234567890123", "9" * 100):
+            result = dispatch({"action": "append", "number": number})
+            self.assertIs(dispatch({"action": "check", "number": result}), True)
+
+    def test_rejected_and_preserved_behaviors(self):
+        # append with no digit raises ValueError; unknown action raises ValueError.
+        with self.assertRaises(ValueError):
+            dispatch({"action": "append", "number": " - "})
+        with self.assertRaises(ValueError):
+            dispatch({"action": "frobnicate", "value": 1})
+        # identity is preserved for any JSON value, including containers.
+        value = {"nested": [1, None, True, "x"]}
+        self.assertEqual(dispatch({"action": "identity", "value": value}), value)
+
+if __name__ == "__main__":
+    unittest.main()
