+"""Domain actions: identity, Luhn checksum validation, Luhn check-digit append."""
+
 def identity(payload):
- return payload['value']
+    return payload['value']
+
+def _digits(payload):
+    """Return the digit characters of payload['number'], spaces and hyphens removed."""
+    return ''.join(c for c in payload['number'] if c not in ' -')
+
+def _luhn_sum(digits):
+    """Sum of the Luhn-weighted digits: rightmost is the check digit, alternate
+    digits moving left are doubled (subtract 9 when the doubling exceeds 9)."""
+    total = 0
+    double = False
+    for c in reversed(digits):
+        d = ord(c) - 48
+        if double:
+            d *= 2
+            if d > 9:
+                d -= 9
+        total += d
+        double = not double
+    return total
+
+def check(payload):
+    """True when the number's Luhn checksum is divisible by ten.
+
+    Input syntax: 0..100 ASCII decimal digits, spaces and hyphens. If no digit
+    remains after removing spaces and hyphens, return False.
+    """
+    digits = _digits(payload)
+    if not digits:
+        return False
+    return _luhn_sum(digits) % 10 == 0
+
+def append(payload):
+    """Return the normalized digits plus the unique Luhn check digit.
+
+    Raises ValueError when no digit remains after removing spaces and hyphens.
+    Leading zeroes are preserved.
+    """
+    digits = _digits(payload)
+    if not digits:
+        raise ValueError('at least one digit is required')
+    check_digit = (10 - _luhn_sum(digits + '0') % 10) % 10
+    return digits + str(check_digit)
