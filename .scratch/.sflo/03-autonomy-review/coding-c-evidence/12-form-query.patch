+import unittest
+import domain
+import api
+import cli
+
+
+class ParseQueryNormal(unittest.TestCase):
+    def test_normal_parse(self):
+        result = api.dispatch({"action": "parse_query", "query": "a=1&b=two&c="})
+        self.assertEqual(result, [["a", "1"], ["b", "two"], ["c", ""]])
+
+    def test_duplicates_and_empty_keys_preserved(self):
+        result = api.dispatch({"action": "parse_query", "query": "=1&a=&a=2&a=3"})
+        self.assertEqual(result, [["", "1"], ["a", ""], ["a", "2"], ["a", "3"]])
+
+    def test_no_equals_means_empty_value(self):
+        self.assertEqual(api.dispatch({"action": "parse_query", "query": "flag"}), [["flag", ""]])
+
+    def test_order_is_preserved_without_normalization(self):
+        self.assertEqual(
+            api.dispatch({"action": "parse_query", "query": "z=1&a=2&m=3"}),
+            [["z", "1"], ["a", "2"], ["m", "3"]],
+        )
+
+    def test_decoded_escapes_never_split_fields(self):
+        # %26 decodes to '&' only after field splitting, so it stays in the value.
+        self.assertEqual(
+            api.dispatch({"action": "parse_query", "query": "a=x%26y%3Dz"}),
+            [["a", "x&y=z"]],
+        )
+
+
+class ParseQueryBoundaries(unittest.TestCase):
+    def test_empty_query_gives_empty_list(self):
+        self.assertEqual(api.dispatch({"action": "parse_query", "query": ""}), [])
+
+    def test_empty_and_consecutive_separators_ignored(self):
+        self.assertEqual(
+            api.dispatch({"action": "parse_query", "query": "&a=1&&b=2&"}),
+            [["a", "1"], ["b", "2"]],
+        )
+
+    def test_plus_and_percent_escapes_decode(self):
+        # '+' -> space, %20 -> space, %C3%A9 -> U+00E9, %25 -> '%', %26 -> '&'
+        self.assertEqual(
+            api.dispatch({"action": "parse_query", "query": "a+b=c+d+%C3%A9+%25%26"}),
+            [["a b", "c d \u00e9 %&"]],
+        )
+
+    def test_split_at_first_equals_only(self):
+        self.assertEqual(
+            api.dispatch({"action": "parse_query", "query": "a=b=c"}),
+            [["a", "b=c"]],
+        )
+
+    def test_max_length_boundary(self):
+        query = ("a=1&" * 500)[:2000]
+        self.assertEqual(len(query), 2000)
+        result = api.dispatch({"action": "parse_query", "query": query})
+        self.assertEqual(result, [["a", "1"]] * 500)
+
+    def test_multibyte_escape_sequence_decodes(self):
+        # U+1F600 needs four bytes: %F0%9F%98%80
+        self.assertEqual(
+            api.dispatch({"action": "parse_query", "query": "%F0%9F%98%80=emoji"}),
+            [["\U0001f600", "emoji"]],
+        )
+
+    def test_input_not_mutated_on_failure(self):
+        payload = {"action": "parse_query", "query": "a=%zz"}
+        try:
+            api.dispatch(payload)
+        except ValueError:
+            pass
+        self.assertEqual(payload, {"action": "parse_query", "query": "a=%zz"})
+
+    def test_input_not_mutated_on_success(self):
+        payload = {"action": "parse_query", "query": "a=%20&b"}
+        result = api.dispatch(payload)
+        self.assertEqual(payload, {"action": "parse_query", "query": "a=%20&b"})
+        self.assertEqual(result, [["a", " "], ["b", ""]])
+
+
+class ParseQueryErrors(unittest.TestCase):
+    def test_bad_percent_escape_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            api.dispatch({"action": "parse_query", "query": "a=%2"})
+
+    def test_nonhex_percent_escape_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            api.dispatch({"action": "parse_query", "query": "a=%zz"})
+
+    def test_percent_at_end_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            api.dispatch({"action": "parse_query", "query": "a=b%"})
+
+    def test_invalid_utf8_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            api.dispatch({"action": "parse_query", "query": "a=%FF"})
+
+    def test_truncated_multibyte_utf8_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            api.dispatch({"action": "parse_query", "query": "a=%C3"})
+
+    def test_unknown_action_still_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            api.dispatch({"action": "nope", "query": ""})
+
+
+class IdentityPreserved(unittest.TestCase):
+    def test_identity_any_json_value(self):
+        for value in [None, True, 0, "", "x", [], {}, [1, [2]], {"k": [None]}]:
+            with self.subTest(value=value):
+                self.assertEqual(api.dispatch({"action": "identity", "value": value}), value)
+
+
+class CliBehavior(unittest.TestCase):
+    def run_cli(self, stdin_text):
+        import subprocess
+
+        cli_path = cli.__file__
+        process = subprocess.run(
+            ["python", "-B", "-I", cli_path],
+            input=stdin_text,
+            capture_output=True,
+            text=True,
+        )
+        return process
+
+    def test_cli_success_exit_zero(self):
+        process = self.run_cli('{"action":"parse_query","query":"a=1&b=%20"}')
+        self.assertEqual(process.returncode, 0)
+        self.assertEqual(process.stdout.strip(), '[["a", "1"], ["b", " "]]')
+        self.assertEqual(process.stderr, "")
+
+    def test_cli_identity_success_exit_zero(self):
+        process = self.run_cli('{"action":"identity","value":{"k":[null,true]}}')
+        self.assertEqual(process.returncode, 0)
+        self.assertEqual(process.stdout.strip(), '{"k": [null, true]}')
+        self.assertEqual(process.stderr, "")
+
+    def test_cli_value_error_exit_two(self):
+        process = self.run_cli('{"action":"parse_query","query":"a=%FF"}')
+        self.assertEqual(process.returncode, 2)
+        self.assertNotEqual(process.stderr.strip(), "")
+        self.assertNotIn("Traceback", process.stderr)
+        self.assertEqual(process.stdout, "")
+
+
+if __name__ == "__main__":
+    unittest.main()
