 def identity(payload):
- return payload['value']
+    return payload['value']
+
+
+def parse_query(payload):
+    """Parse an ampersand-separated query string into ordered [key, value] pairs.
+
+    Input (payload["query"]) is guaranteed an ASCII string of at most 2000
+    characters with no leading question mark. Empty fields are ignored. Each
+    nonempty field is split at its first "="; a field without "=" yields an
+    empty value. "+" decodes to a space, and "%XX" decodes to a byte; the
+    collected bytes are then decoded as strict UTF-8.
+
+    Raises ValueError on a malformed percent escape or on bytes that are not
+    valid UTF-8. The input is never mutated, even on failure.
+    """
+    query = payload["query"]
+    pairs = []
+    for field in query.split("&"):
+        if not field:
+            continue
+        key_text, sep, value_text = field.partition("=")
+        pairs.append([_decode_token(key_text), _decode_token(value_text)])
+    return pairs
+
+
+def _decode_token(token):
+    """Decode '+' as space and '%XX' as a byte, then strict UTF-8 decode."""
+    buffer = bytearray()
+    index = 0
+    length = len(token)
+    while index < length:
+        char = token[index]
+        if char == '+':
+            buffer.append(0x20)
+            index += 1
+        elif char == '%':
+            digits = token[index + 1:index + 3]
+            if len(digits) != 2 or not _is_hex_pair(digits):
+                raise ValueError(
+                    "invalid percent escape: expected two hex digits after '%'"
+                )
+            buffer.append(int(digits, 16))
+            index += 3
+        else:
+            buffer.extend(char.encode("utf-8"))
+            index += 1
+    try:
+        return buffer.decode("utf-8")
+    except UnicodeDecodeError as error:
+        raise ValueError("invalid UTF-8 in query token: " + str(error)) from None
+
+
+def _is_hex_pair(digits):
+    if len(digits) != 2:
+        return False
+    for char in digits:
+        if char not in "0123456789abcdefABCDEF":
+            return False
+    return True
