@@ -0,0 +1,85 @@
+import unittest
+import json
+import subprocess
+import sys
+import pathlib
+
+ROOT = pathlib.Path(__file__).resolve().parent.parent
+
+
+class WrapNormal(unittest.TestCase):
+    def test_wrap_normal(self):
+        from api import dispatch
+        payload = {"action": "wrap", "text": "the quick brown fox jumps", "width": 10}
+        self.assertEqual(
+            dispatch(payload),
+            ["the quick", "brown fox", "jumps"],
+        )
+        # separators collapsed, tabs/newline paragraphs handled
+        payload = {"action": "wrap", "text": "a\t\tb   c\nd", "width": 5}
+        self.assertEqual(dispatch(payload), ["a b c", "d"])
+
+
+class WrapBoundaries(unittest.TestCase):
+    def test_wrap_boundaries(self):
+        from api import dispatch
+        # empty text -> one empty paragraph/line
+        self.assertEqual(dispatch({"action": "wrap", "text": "", "width": 1}), [""])
+        # whitespace-only and empty paragraphs each yield one empty line
+        self.assertEqual(
+            dispatch({"action": "wrap", "text": "  \n\nx", "width": 5}),
+            ["", "", "x"],
+        )
+        # width 1: every word on its own line; over-long word intact
+        self.assertEqual(
+            dispatch({"action": "wrap", "text": "hi there", "width": 1}),
+            ["hi", "there"],
+        )
+        # exact fit boundary: word fits exactly at width
+        self.assertEqual(
+            dispatch({"action": "wrap", "text": "ab cd", "width": 5}),
+            ["ab cd"],
+        )
+        # one code point over width forces a break (Unicode measured by len)
+        self.assertEqual(
+            dispatch({"action": "wrap", "text": "ab cdé", "width": 5}),
+            ["ab", "cdé"],
+        )
+
+    def test_unknown_action_rejected(self):
+        from api import dispatch
+        with self.assertRaises(ValueError) as cm:
+            dispatch({"action": "nope", "value": 1})
+        self.assertEqual(str(cm.exception), "unknown action: nope")
+
+
+class CliBehavior(unittest.TestCase):
+    def _run_cli(self, stdin_text):
+        result = subprocess.run(
+            [sys.executable, "cli.py"],
+            input=stdin_text,
+            text=True,
+            capture_output=True,
+            cwd=str(ROOT),
+        )
+        return result
+
+    def test_cli_identity_and_wrap_success(self):
+        r = self._run_cli('{"action": "identity", "value": {"k": [1, null]}}')
+        self.assertEqual(r.returncode, 0)
+        self.assertEqual(r.stderr, "")
+        self.assertEqual(json.loads(r.stdout), {"k": [1, None]})
+        r = self._run_cli('{"action": "wrap", "text": "a b\\n\\nc", "width": 3}')
+        self.assertEqual(r.returncode, 0)
+        self.assertEqual(json.loads(r.stdout), ["a b", "", "c"])
+
+    def test_cli_value_error_exit_2(self):
+        r = self._run_cli('{"action": "nope"}')
+        self.assertEqual(r.returncode, 2)
+        self.assertNotEqual(r.stderr, "")
+        self.assertEqual(r.stdout, "")
+        self.assertNotIn("Traceback", r.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
