 def identity(payload):
- return payload['value']
+    return payload['value']
+
+
+def wrap(payload):
+    """Greedy word wrap.
+
+    Split text on literal newlines into paragraphs (empty paragraphs preserved).
+    Within a paragraph split on whitespace, collapse separators to one ASCII
+    space, greedily place words on lines of at most `width` code points
+    (Python len). A word longer than width occupies its own line intact.
+    Each empty/whitespace-only paragraph contributes one empty line.
+    """
+    text = payload['text']
+    width = payload['width']
+    lines = []
+    for paragraph in text.split('\n'):
+        words = paragraph.split()
+        if not words:
+            lines.append('')
+            continue
+        current = words[0]
+        for word in words[1:]:
+            candidate = current + ' ' + word
+            if len(candidate) <= width:
+                current = candidate
+            else:
+                lines.append(current)
+                current = word
+        lines.append(current)
+    return lines
