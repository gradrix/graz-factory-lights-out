 def identity(payload):
- return payload['value']
+    return payload['value']
+
+def parse_duration(text):
+    """Parse an action-seconds string like '1h2m3s' and return the exact total seconds.
+
+    Grammar: one or more adjacent tokens, each an unsigned ASCII decimal
+    integer (leading zeroes allowed) immediately followed by h, m or s.
+    Units appear at most once and in descending order (h, then m, then s);
+    omissions allowed. Values need not be below 60. Empty text, whitespace,
+    signs, unknown units, repeated/reordered units or dangling digits raise
+    ValueError. Input is never mutated.
+    """
+    if not isinstance(text, str):
+        raise ValueError("duration text must be a string")
+    if len(text) > 100:
+        raise ValueError("duration text must be at most 100 characters")
+    if text == "":
+        raise ValueError("empty duration text")
+    total = 0
+    units = {'h': 3600, 'm': 60, 's': 1}
+    limit = 3601  # units must strictly descend: h(3600) > m(60) > s(1)
+    i = 0
+    tokens = 0
+    while i < len(text):
+        j = i
+        while j < len(text) and '0' <= text[j] <= '9':
+            j += 1
+        if j == i:
+            raise ValueError("expected digits at position %d" % i)
+        if j == len(text):
+            raise ValueError("dangling digits at position %d" % i)
+        unit = text[j]
+        if unit not in units:
+            raise ValueError("unknown unit %r at position %d" % (unit, j))
+        if units[unit] >= limit:
+            raise ValueError("units must be h, m, s in descending order, each at most once")
+        limit = units[unit]
+        total += int(text[i:j]) * units[unit]
+        tokens += 1
+        i = j + 1
+    if tokens == 0:
+        raise ValueError("no duration tokens")
+    return total
