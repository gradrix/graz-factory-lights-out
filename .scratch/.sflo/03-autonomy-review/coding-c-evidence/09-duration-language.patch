@@ -0,0 +1,38 @@
+import unittest
+from api import dispatch
+
+class SecondsTests(unittest.TestCase):
+    def test_seconds_normal_and_boundary(self):
+        # normal: all units, descending, values above 60 allowed
+        self.assertEqual(dispatch({"action": "seconds", "text": "1h2m3s"}), 3723)
+        # boundary: empty text raises
+        with self.assertRaises(ValueError):
+            dispatch({"action": "seconds", "text": ""})
+        # boundary: maximum length 100 characters parses exactly
+        self.assertEqual(dispatch({"action": "seconds", "text": "9" * 99 + "s"}), 10**99 - 1)
+        # boundary: 101 characters rejected
+        with self.assertRaises(ValueError):
+            dispatch({"action": "seconds", "text": "9" * 100 + "s"})
+        # omissions and leading zeroes
+        self.assertEqual(dispatch({"action": "seconds", "text": "000h010m007s"}), 607)
+        self.assertEqual(dispatch({"action": "seconds", "text": "90m"}), 5400)
+        self.assertEqual(dispatch({"action": "seconds", "text": "0s"}), 0)
+
+    def test_seconds_rejected_inputs(self):
+        bad = ["1h2m3s4h", "1h2m3s4m", "1s2m", "1s2h", "2m1h", "1h30", "12",
+               "1 h", "1h ", " 1h", "+1h", "-1h", "1x", "1H", "h", "1h2m3s ",
+               "1.5h", "١h"]
+        for text in bad:
+            with self.assertRaises(ValueError):
+                dispatch({"action": "seconds", "text": text})
+
+    def test_identity_preserved_and_unknown_action(self):
+        for value in [None, True, 3, "x", [1, [2]], {"k": None}]:
+            payload = {"action": "identity", "value": value}
+            self.assertEqual(dispatch(payload), value)
+            self.assertEqual(payload["value"], value)  # input not mutated
+        with self.assertRaises(ValueError):
+            dispatch({"action": "nope", "text": "1h"})
+
+if __name__ == "__main__":
+    unittest.main()
