 def identity(payload):
- return payload['value']
+    return payload['value']
+
+def tally(payload):
+    candidates = payload['candidates']
+    ballots = payload['ballots']
+
+    order = {}
+    for index, name in enumerate(candidates):
+        order[name] = index
+
+    votes = {name: 0 for name in candidates}
+
+    for ballot in ballots:
+        approved = set()
+        for name in ballot:
+            if name not in order:
+                raise ValueError("unknown candidate: " + str(name))
+            approved.add(name)
+        for name in approved:
+            votes[name] += 1
+
+    ranked = sorted(candidates, key=lambda name: (-votes[name], order[name]))
+    return [{"candidate": name, "votes": votes[name]} for name in ranked]
