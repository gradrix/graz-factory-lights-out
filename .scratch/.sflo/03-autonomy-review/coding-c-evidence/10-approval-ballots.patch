@@ -0,0 +1,68 @@
+import unittest
+
+from api import dispatch
+
+
+class TallyTests(unittest.TestCase):
+    def test_normal_tally_orders_by_votes_then_candidate_order(self):
+        payload = {
+            "action": "tally",
+            "candidates": ["alice", "bob", "carol"],
+            "ballots": [["carol", "alice"], ["bob"], ["alice", "alice", "carol"]],
+        }
+        original = [list(ballot) for ballot in payload["ballots"]]
+        self.assertEqual(
+            dispatch(payload),
+            [
+                {"candidate": "alice", "votes": 2},
+                {"candidate": "carol", "votes": 2},
+                {"candidate": "bob", "votes": 1},
+            ],
+        )
+        # repeated names inside one ballot count once
+        self.assertEqual(payload["ballots"], original)
+        self.assertEqual(payload["candidates"], ["alice", "bob", "carol"])
+
+    def test_boundary_empty_and_zero_vote_candidates(self):
+        self.assertEqual(
+            dispatch({"action": "tally", "candidates": [], "ballots": []}), []
+        )
+        self.assertEqual(
+            dispatch(
+                {
+                    "action": "tally",
+                    "candidates": ["a", "b", "c"],
+                    "ballots": [[]],
+                }
+            ),
+            [
+                {"candidate": "a", "votes": 0},
+                {"candidate": "b", "votes": 0},
+                {"candidate": "c", "votes": 0},
+            ],
+        )
+        self.assertEqual(
+            dispatch({"action": "tally", "candidates": ["solo"], "ballots": []}),
+            [{"candidate": "solo", "votes": 0}],
+        )
+
+    def test_rejected_unknown_candidate_raises_valueerror(self):
+        payload = {
+            "action": "tally",
+            "candidates": ["alice"],
+            "ballots": [["alice", "mallory"]],
+        }
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+        self.assertEqual(payload["ballots"], [["alice", "mallory"]])
+
+    def test_identity_and_unknown_action_are_preserved(self):
+        for value in [None, True, 0, "", {"k": [1, 2]}, "x"]:
+            payload = {"action": "identity", "value": value}
+            self.assertEqual(dispatch(payload), value)
+        with self.assertRaises(ValueError):
+            dispatch({"action": "nope", "value": 1})
+
+
+if __name__ == "__main__":
+    unittest.main()
