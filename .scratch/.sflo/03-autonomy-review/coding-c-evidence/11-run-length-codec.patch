@@ -0,0 +1,109 @@
+import json
+import subprocess
+import unittest
+import os
+import sys
+
+
+def cli(payload):
+    """Run the public CLI and return (returncode, stdout, stderr)."""
+    process = subprocess.run(
+        [sys.executable, os.path.join(os.path.dirname(os.path.dirname(__file__)), "cli.py")],
+        input=json.dumps(payload),
+        capture_output=True,
+        text=True,
+    )
+    return process.returncode, process.stdout, process.stderr
+
+
+class EncodeDecodeTestCase(unittest.TestCase):
+    def test_encode_normal_and_boundary(self):
+        from api import dispatch
+        self.assertEqual(
+            dispatch({"action": "encode", "values": [1, 1, 2, 2, 2, 1]}),
+            [[1, 2], [2, 3], [1, 1]],
+        )
+        # boundary: empty input encodes to an empty list
+        self.assertEqual(dispatch({"action": "encode", "values": []}), [])
+        # boundary: single element
+        self.assertEqual(dispatch({"action": "encode", "values": [7]}), [[7, 1]])
+        # adjacent runs never merge across differing values
+        self.assertEqual(
+            dispatch({"action": "encode", "values": [1, 2, 1]}),
+            [[1, 1], [2, 1], [1, 1]],
+        )
+        # boundary: maximum supported input length (10000)
+        self.assertEqual(
+            dispatch({"action": "encode", "values": [5] * 10000}), [[5, 10000]]
+        )
+
+    def test_decode_normal_and_boundary(self):
+        from api import dispatch
+        self.assertEqual(
+            dispatch({"action": "decode", "runs": [[1, 2], [2, 3], [1, 1]]}),
+            [1, 1, 2, 2, 2, 1],
+        )
+        # adjacent same-valued runs are permitted and stay separate
+        self.assertEqual(
+            dispatch({"action": "decode", "runs": [[4, 2], [4, 3]]}), [4] * 5
+        )
+        # boundary: empty runs decode to an empty list
+        self.assertEqual(dispatch({"action": "decode", "runs": []}), [])
+        # boundary: exactly the maximum decoded length (10000) is accepted
+        self.assertEqual(
+            len(dispatch({"action": "decode", "runs": [[0, 10000]]})), 10000
+        )
+        self.assertEqual(
+            len(dispatch({"action": "decode", "runs": [[0, 9999], [1, 1]]})),
+            10000,
+        )
+
+    def test_decode_rejected_inputs(self):
+        from api import dispatch
+        # non-positive counts are rejected
+        with self.assertRaises(ValueError):
+            dispatch({"action": "decode", "runs": [[1, 0]]})
+        with self.assertRaises(ValueError):
+            dispatch({"action": "decode", "runs": [[1, -3]]})
+        # decoded length beyond the limit is rejected
+        with self.assertRaises(ValueError):
+            dispatch({"action": "decode", "runs": [[1, 10001]]})
+        with self.assertRaises(ValueError):
+            dispatch({"action": "decode", "runs": [[1, 6000], [2, 6000]]})
+        # unknown actions are rejected
+        with self.assertRaises(ValueError):
+            dispatch({"action": "transpose", "values": [1]})
+
+    def test_no_mutation_and_atomicity(self):
+        from api import dispatch
+        runs = [[1, 2], [1, 3]]
+        self.assertEqual(dispatch({"action": "decode", "runs": runs}), [1] * 5)
+        self.assertEqual(runs, [[1, 2], [1, 3]])
+        values = [1, 1, 2]
+        self.assertEqual(dispatch({"action": "encode", "values": values}), [[1, 2], [2, 1]])
+        self.assertEqual(values, [1, 1, 2])
+        # a rejected decode leaves the caller's runs list untouched
+        bad = [[1, 5], [2, 0]]
+        with self.assertRaises(ValueError):
+            dispatch({"action": "decode", "runs": bad})
+        self.assertEqual(bad, [[1, 5], [2, 0]])
+
+    def test_cli_success_and_error_paths(self):
+        code, out, err = cli({"action": "encode", "values": [1, 1, 2]})
+        self.assertEqual((code, json.loads(out), err), (0, [[1, 2], [2, 1]], ""))
+        code, out, err = cli({"action": "decode", "runs": [[-1, 2]]})
+        self.assertEqual((code, json.loads(out), err), (0, [-1, -1], ""))
+        code, out, err = cli({"action": "identity", "value": {"a": [1, None]}})
+        self.assertEqual((code, json.loads(out), err), (0, {"a": [1, None]}, ""))
+        # ValueError: exit 2, nonempty stderr, no traceback, empty stdout
+        code, out, err = cli({"action": "decode", "runs": [[1, 0]]})
+        self.assertEqual((code, out), (2, ""))
+        self.assertTrue(err.strip())
+        self.assertNotIn("Traceback", err)
+        code, out, err = cli({"action": "nope"})
+        self.assertEqual((code, out), (2, ""))
+        self.assertTrue(err.strip())
+
+
+if __name__ == "__main__":
+    unittest.main()
