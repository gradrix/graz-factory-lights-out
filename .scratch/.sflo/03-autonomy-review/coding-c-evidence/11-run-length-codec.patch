+MAX_DECODED_LENGTH = 10000
+
+
 def identity(payload):
- return payload['value']
+    return payload['value']
+
+
+def encode(payload):
+    values = payload['values']
+    runs = []
+    for value in values:
+        if runs and runs[-1][0] == value:
+            runs[-1][1] += 1
+        else:
+            runs.append([value, 1])
+    return runs
+
+
+def decode(payload):
+    values = []
+    for run in payload['runs']:
+        count = run[1]
+        if count <= 0:
+            raise ValueError("count must be positive: %r" % (count,))
+        if len(values) + count > MAX_DECODED_LENGTH:
+            raise ValueError("decoded length exceeds %d" % (MAX_DECODED_LENGTH,))
+        values.extend([run[0]] * count)
+    return values
