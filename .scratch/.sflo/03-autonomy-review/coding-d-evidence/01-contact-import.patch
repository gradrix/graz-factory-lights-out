-def legacy(p):return [x['email'] for x in p['existing']]
+import csv
+import io
+
+
+def legacy(p):
+    return [x['email'] for x in p['existing']]
+
+
+def import_contacts(payload):
+    """Import contacts from CSV text against an existing contact list.
+
+    payload: {"action": "import_contacts", "csv": str, "existing": [{"email","name"}, ...]}
+    Returns {"added": [{"email","name"}, ...], "skipped": int}.
+    Raises ValueError for an invalid header, wrong column count, invalid
+    email or empty name. Input objects are never mutated.
+    """
+    csv_text = payload["csv"]
+    existing = payload["existing"]
+
+    if not isinstance(csv_text, str):
+        raise ValueError("csv must be a string")
+
+    # An empty string is not a valid CSV document (no header record).
+    if csv_text == "":
+        raise ValueError("csv must contain a header record")
+
+    # Standard comma-separated CSV with the double-quote quoting convention.
+    # Blank lines become empty records, which fail the two-column check.
+    reader = csv.reader(io.StringIO(csv_text, newline=""), skipinitialspace=False)
+    records = []
+    for record in reader:
+        records.append(record)
+
+    if not records:
+        raise ValueError("csv must contain a header record")
+
+    header = records[0]
+    if header != ["email", "name"]:
+        raise ValueError("csv header must be exactly 'email,name'")
+
+    existing_emails = set()
+    for contact in existing:
+        existing_emails.add(contact["email"])
+
+    added = []
+    skipped = 0
+    seen = set()
+    for record in records[1:]:
+        if len(record) != 2:
+            raise ValueError("csv record must have exactly two columns")
+        email = record[0].strip().lower()
+        name = record[1].strip()
+        if not _valid_email(email):
+            raise ValueError("csv record has an invalid email")
+        if name == "":
+            raise ValueError("csv record has an empty name")
+        if email in seen or email in existing_emails:
+            skipped += 1
+            continue
+        seen.add(email)
+        added.append({"email": email, "name": name})
+
+    return {"added": added, "skipped": skipped}
+
+
+def _valid_email(email):
+    if email.count("@") != 1:
+        return False
+    left, _, right = email.partition("@")
+    if left == "" or right == "":
+        return False
+    for ch in email:
+        if ch.isspace():
+            return False
+    return True
