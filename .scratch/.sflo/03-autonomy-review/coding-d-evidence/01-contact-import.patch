@@ -0,0 +1,134 @@
+import json
+import os
+import subprocess
+import sys
+import unittest
+
+import api
+
+
+def emails_of(existing):
+    return [contact["email"] for contact in existing]
+
+
+class ImportContactsNormalCase(unittest.TestCase):
+    def test_import_contacts_normal_case(self):
+        payload = {
+            "action": "import_contacts",
+            "csv": 'email,name\nA@B.COM , Alice\nb@c.com,"Doe, B"\na@b.com,dupe\n',
+            "existing": [{"email": "z@y.com", "name": "Zed"}],
+        }
+        result = api.dispatch(payload)
+        self.assertEqual(
+            result,
+            {
+                "added": [
+                    {"email": "a@b.com", "name": "Alice"},
+                    {"email": "b@c.com", "name": "Doe, B"},
+                ],
+                "skipped": 1,
+            },
+        )
+        # the input contact list is untouched
+        self.assertEqual(emails_of(payload["existing"]), ["z@y.com"])
+
+
+class ImportContactsBoundaries(unittest.TestCase):
+    def test_two_hundred_rows_and_header_only_csv(self):
+        rows = ["email,name"]
+        for i in range(199):
+            rows.append("u%d@ex.com,N%d" % (i, i))
+        self.assertEqual(len(rows), 200)
+        result = api.dispatch(
+            {"action": "import_contacts", "csv": "\n".join(rows), "existing": []}
+        )
+        self.assertEqual(len(result["added"]), 199)
+        self.assertEqual(result["skipped"], 0)
+        # a header-only csv is valid and adds nothing
+        empty = api.dispatch(
+            {"action": "import_contacts", "csv": "email,name\n", "existing": []}
+        )
+        self.assertEqual(empty, {"added": [], "skipped": 0})
+
+    def test_quoted_newline_in_name_and_existing_duplicates(self):
+        csv_text = 'email,name\na@b.com,"line1\nline2"\na@b.com,again\n'
+        existing = [{"email": "a@b.com", "name": "kept"}]
+        result = api.dispatch(
+            {"action": "import_contacts", "csv": csv_text, "existing": existing}
+        )
+        self.assertEqual(result, {"added": [], "skipped": 2})
+        self.assertEqual(existing, [{"email": "a@b.com", "name": "kept"}])
+
+
+class ImportContactsRejections(unittest.TestCase):
+    def test_invalid_records_raise_value_error(self):
+        bad = [
+            'name,email\na@b.com,x',          # wrong header order/spelling
+            'Email,name\na@b.com,x',          # header must be exact
+            'email,name\na@b.com',            # one column
+            'email,name\na@b.com,x,y',        # three columns
+            'email,name\na@b.c@m,x',          # two @ signs
+            'email,name\n@b.com,x',           # empty left part
+            'email,name\na@,x',               # empty right part
+            'email,name\na b@c.com,x',        # whitespace inside email
+            'email,name\na@b.c,\t \n',        # blank name
+            '',                               # empty csv string
+        ]
+        for csv_text in bad:
+            with self.assertRaises(ValueError):
+                api.dispatch(
+                    {"action": "import_contacts", "csv": csv_text, "existing": []}
+                )
+
+    def test_unknown_action_still_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            api.dispatch({"action": "nope", "csv": "email,name", "existing": []})
+
+    def test_legacy_emails_action_is_preserved(self):
+        existing = [{"email": "a@b.com", "name": "A"}, {"email": "c@d.com", "name": "C"}]
+        self.assertEqual(api.dispatch({"action": "emails", "existing": existing}), ["a@b.com", "c@d.com"])
+
+
+class CliBehaviour(unittest.TestCase):
+    def run_cli(self, payload):
+        root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+        proc = subprocess.run(
+            [sys.executable, os.path.join(root, "cli.py")],
+            input=json.dumps(payload),
+            capture_output=True,
+            text=True,
+        )
+        return proc
+
+    def test_cli_success_writes_json_and_exits_zero(self):
+        proc = self.run_cli(
+            {
+                "action": "import_contacts",
+                "csv": 'email,name\na@b.com,"Alice"\n',
+                "existing": [],
+            }
+        )
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(proc.stderr, "")
+        self.assertEqual(
+            json.loads(proc.stdout),
+            {"added": [{"email": "a@b.com", "name": "Alice"}], "skipped": 0},
+        )
+
+    def test_cli_value_error_exits_two_with_stderr_and_no_traceback(self):
+        proc = self.run_cli(
+            {"action": "import_contacts", "csv": "email,name\nno-at,x", "existing": []}
+        )
+        self.assertEqual(proc.returncode, 2)
+        self.assertNotEqual(proc.stderr.strip(), "")
+        self.assertNotIn("Traceback", proc.stderr)
+        self.assertEqual(proc.stdout, "")
+
+    def test_cli_legacy_action_still_works(self):
+        proc = self.run_cli({"action": "emails", "existing": [{"email": "a@b.com", "name": "A"}]})
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(json.loads(proc.stdout), ["a@b.com"])
+
+
+if __name__ == "__main__":
+    unittest.main()
