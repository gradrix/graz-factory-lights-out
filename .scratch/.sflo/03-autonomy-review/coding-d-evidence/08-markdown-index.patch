+import unittest
+import api
+
+
+class HeadingsTest(unittest.TestCase):
+    def test_normal_case_with_fences_and_anchor_collisions(self):
+        markdown = (
+            "# Title\n"
+            "```\n"
+            "# not a heading\n"
+            "```\n"
+            "## Title ##\n"
+            "##  H\u00e9llo, World!  \n"
+            "## h\u00e9llo world\n"
+            "## h\u00e9llo world\n"
+            "not-a-heading\n"
+            " ## indented\n"
+            "####### seven\n"
+            "#nospace\n"
+        )
+        self.assertEqual(
+            api.dispatch({"action": "headings", "markdown": markdown}),
+            [
+                {"level": 1, "text": "Title", "line": 1, "anchor": "title"},
+                {"level": 2, "text": "Title ##", "line": 5, "anchor": "title-2"},
+                {"level": 2, "text": "H\u00e9llo, World!", "line": 6, "anchor": "hllo-world"},
+                {"level": 2, "text": "h\u00e9llo world", "line": 7, "anchor": "hllo-world-2"},
+                {"level": 2, "text": "h\u00e9llo world", "line": 8, "anchor": "hllo-world-3"},
+            ],
+        )
+
+    def test_boundaries(self):
+        # 10000 code points is the maximum accepted length; 10001 is rejected.
+        with self.assertRaises(ValueError):
+            api.dispatch({"action": "headings", "markdown": "#" * 10001})
+        at_limit = ("#" * 6 + " x").ljust(10000, " ")
+        self.assertEqual(
+            api.dispatch({"action": "headings", "markdown": at_limit}),
+            [{"level": 6, "text": "x", "line": 1, "anchor": "x"}],
+        )
+        # Empty markdown yields no headings; an empty anchor base falls back to "section".
+        self.assertEqual(api.dispatch({"action": "headings", "markdown": ""}), [])
+        self.assertEqual(
+            api.dispatch({"action": "headings", "markdown": "### !!!\n### !!!"}),
+            [
+                {"level": 3, "text": "!!!", "line": 1, "anchor": "section"},
+                {"level": 3, "text": "!!!", "line": 2, "anchor": "section-2"},
+            ],
+        )
+
+    def test_unknown_action_is_rejected(self):
+        with self.assertRaises(ValueError):
+            api.dispatch({"action": "nope", "markdown": ""})
+
+
+class LegacyTest(unittest.TestCase):
+    def test_line_count_still_works(self):
+        self.assertEqual(api.dispatch({"action": "line_count", "markdown": "a\nb"}), 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
