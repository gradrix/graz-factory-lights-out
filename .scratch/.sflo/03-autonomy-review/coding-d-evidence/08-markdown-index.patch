@@ -1 +1,39 @@
-def legacy(p):return len(p['markdown'].splitlines())
+import re
+
+_FENCE = "```"
+_HEADING_RE = re.compile(r"#{1,6} ")
+_RUN_RE = re.compile(r"[ -]+")
+
+
+def legacy(p):
+    return len(p['markdown'].splitlines())
+
+
+def _anchor_base(text):
+    kept = [c for c in text.lower() if ("a" <= c <= "z") or ("0" <= c <= "9") or c == " " or c == "-"]
+    base = _RUN_RE.sub("-", "".join(kept)).strip("-")
+    return base or "section"
+
+
+def headings(markdown):
+    result = []
+    used = set()
+    fenced = False
+    for number, line in enumerate(markdown.splitlines(), 1):
+        if line.strip().startswith(_FENCE):
+            fenced = not fenced
+            continue
+        if fenced:
+            continue
+        match = _HEADING_RE.match(line)
+        if not match:
+            continue
+        anchor = _anchor_base(line[match.end():].strip())
+        if anchor in used:
+            suffix = 2
+            while f"{anchor}-{suffix}" in used:
+                suffix += 1
+            anchor = f"{anchor}-{suffix}"
+        used.add(anchor)
+        result.append({"level": match.end() - 1, "text": line[match.end():].strip(), "line": number, "anchor": anchor})
+    return result
