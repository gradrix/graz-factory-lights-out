+import unittest
+import subprocess
+
+
+class CliTest(unittest.TestCase):
+    def test_cli_success(self):
+        proc = subprocess.run(
+            ["python", "cli.py"],
+            input='{"action": "headings", "markdown": "# A\\n```\\n# hidden\\n```\\n## A"}',
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(proc.stderr, "")
+        self.assertEqual(
+            eval(proc.stdout),
+            [
+                {"level": 1, "text": "A", "line": 1, "anchor": "a"},
+                {"level": 2, "text": "A", "line": 5, "anchor": "a-2"},
+            ],
+        )
+
+    def test_cli_value_error_exit_2(self):
+        proc = subprocess.run(
+            ["python", "cli.py"],
+            input='{"action": "nope", "markdown": ""}',
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual(proc.returncode, 2)
+        self.assertNotEqual(proc.stderr, "")
+        self.assertNotIn("Traceback", proc.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
