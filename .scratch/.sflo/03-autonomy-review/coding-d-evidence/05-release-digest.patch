--- a/domain.py
+++ b/domain.py
@@ -1 +1,21 @@
 def legacy(p):return [c['id'] for c in p['changes']]
+
+def digest(p):
+    changes = p['changes']
+    last_index = {}
+    for i, row in enumerate(changes):
+        last_index[row['id']] = i
+    kept = [changes[i] for i in sorted(last_index.values()) if not changes[i]['internal']]
+    sections = []
+    for category, heading in (('added', '## Added'), ('fixed', '## Fixed'), ('removed', '## Removed')):
+        rows = [row for row in kept if row['category'] == category]
+        if not rows:
+            continue
+        lines = [heading]
+        for row in rows:
+            title = ' '.join(row['title'].split())
+            lines.append('- ' + title)
+        sections.append('\n'.join(lines))
+    if not sections:
+        return ''
+    return '\n\n'.join(sections) + '\n'
