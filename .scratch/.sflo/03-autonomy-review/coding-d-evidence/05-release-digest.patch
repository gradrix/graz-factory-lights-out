@@ -0,0 +1,101 @@
+import json
+import subprocess
+import unittest
+
+from api import dispatch
+
+
+class NormalCaseTests(unittest.TestCase):
+    def test_digest_normal_case(self):
+        payload = {
+            "action": "digest",
+            "changes": [
+                {"id": "1", "category": "added", "title": "  Add   new  *feature* ", "internal": False},
+                {"id": "2", "category": "fixed", "title": "Fix #2\tbug", "internal": False},
+                {"id": "1", "category": "removed", "title": "Later wins (last occurrence)", "internal": False},
+                {"id": "3", "category": "added", "title": "secret", "internal": True},
+            ],
+        }
+        original = json.loads(json.dumps(payload))
+        result = dispatch(payload)
+        self.assertEqual(
+            result,
+            "## Fixed\n"
+            "- Fix #2 bug\n"
+            "\n"
+            "## Removed\n"
+            "- Later wins (last occurrence)\n",
+        )
+        # input must not be mutated
+        self.assertEqual(payload, original)
+        # legacy action still works
+        self.assertEqual(dispatch({"action": "change_ids", "changes": [{"id": "x"}]}), ["x"])
+
+
+class BoundaryTests(unittest.TestCase):
+    def test_digest_empty_changes_returns_empty_string(self):
+        self.assertEqual(dispatch({"action": "digest", "changes": []}), "")
+
+    def test_digest_all_internal_returns_empty_string(self):
+        payload = {
+            "action": "digest",
+            "changes": [
+                {"id": "a", "category": "added", "title": "hidden", "internal": True},
+                {"id": "a", "category": "fixed", "title": "hidden too", "internal": True},
+            ],
+        }
+        self.assertEqual(dispatch(payload), "")
+
+    def test_digest_two_hundred_rows_boundary(self):
+        changes = [
+            {"id": str(i), "category": "added", "title": "item %d" % i, "internal": False}
+            for i in range(200)
+        ]
+        result = dispatch({"action": "digest", "changes": changes})
+        self.assertEqual(result.count("- item "), 200)
+        self.assertTrue(result.startswith("## Added\n"))
+        self.assertTrue(result.endswith("\n"))
+
+    def test_digest_whitespace_only_title_boundary(self):
+        payload = {
+            "action": "digest",
+            "changes": [{"id": "1", "category": "fixed", "title": " \t\n ", "internal": False}],
+        }
+        self.assertEqual(dispatch(payload), "## Fixed\n- \n")
+
+
+class RejectionTests(unittest.TestCase):
+    def test_unknown_action_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            dispatch({"action": "nope", "changes": []})
+
+    def test_cli_exits_2_on_value_error(self):
+        proc = subprocess.run(
+            ["python", "cli.py"],
+            input=json.dumps({"action": "nope", "changes": []}),
+            capture_output=True,
+            text=True,
+            cwd="/workspace",
+        )
+        self.assertEqual(proc.returncode, 2)
+        self.assertNotEqual(proc.stderr, "")
+        self.assertEqual(proc.stdout, "")
+
+    def test_cli_success_json_roundtrip(self):
+        payload = {"action": "digest", "changes": [{"id": "1", "category": "added", "title": "hi", "internal": False}]}
+        proc = subprocess.run(
+            ["python", "cli.py"],
+            input=json.dumps(payload),
+            capture_output=True,
+            text=True,
+            cwd="/workspace",
+        )
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(
+            json.loads(proc.stdout),
+            "## Added\n- hi\n",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
