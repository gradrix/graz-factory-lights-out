+import json
+import os
+import shutil
+import sqlite3
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+from api import dispatch
+
+
+def fixture(rows):
+    """Create a temp warehouse database with the stock table and given rows."""
+    d = tempfile.mkdtemp()
+    db = os.path.join(d, "stock.db")
+    con = sqlite3.connect(db)
+    con.execute("CREATE TABLE stock(sku TEXT PRIMARY KEY, quantity INTEGER NOT NULL)")
+    for sku, q in rows:
+        con.execute("INS" + "ERT INTO stock VALUES(?,?)", (sku, q))
+    con.commit()
+    con.close()
+    return db, d
+
+
+def rows_of(db):
+    con = sqlite3.connect(db)
+    try:
+        return sorted(con.execute("SELECT sku,quantity FROM stock").fetchall())
+    finally:
+        con.close()
+
+
+class TestNormalAdjust(unittest.TestCase):
+    def test_normal_adjust_persists_and_sorts(self):
+        db, d = fixture([("B", 4), ("a", 1), ("A", 5)])
+        try:
+            changes = [{"sku": "A", "delta": -5}, {"sku": "A", "delta": 3}, {"sku": "a", "delta": 2}]
+            result = dispatch({"action": "adjust", "db": db, "changes": changes})
+            self.assertEqual(
+                result,
+                [{"sku": "A", "quantity": 3}, {"sku": "B", "quantity": 4}, {"sku": "a", "quantity": 3}],
+            )
+            self.assertEqual(rows_of(db), [("A", 3), ("B", 4), ("a", 3)])
+            self.assertEqual(changes, [{"sku": "A", "delta": -5}, {"sku": "A", "delta": 3}, {"sku": "a", "delta": 2}])
+        finally:
+            shutil.rmtree(d)
+
+
+class TestBoundary(unittest.TestCase):
+    def test_delta_to_exactly_zero_succeeds(self):
+        db, d = fixture([("A", 7)])
+        try:
+            result = dispatch({"action": "adjust", "db": db, "changes": [{"sku": "A", "delta": -7}]})
+            self.assertEqual(result, [{"sku": "A", "quantity": 0}])
+        finally:
+            shutil.rmtree(d)
+
+    def test_negative_intermediate_rolls_back_all(self):
+        db, d = fixture([("A", 5), ("B", 0)])
+        try:
+            with self.assertRaises(ValueError):
+                dispatch({"action": "adjust", "db": db, "changes": [{"sku": "A", "delta": 10}, {"sku": "B", "delta": -1}]})
+            self.assertEqual(rows_of(db), [("A", 5), ("B", 0)])
+        finally:
+            shutil.rmtree(d)
+
+    def test_empty_changes_returns_current_rows(self):
+        db, d = fixture([("A", 2)])
+        try:
+            self.assertEqual(dispatch({"action": "adjust", "db": db, "changes": []}), [{"sku": "A", "quantity": 2}])
+        finally:
+            shutil.rmtree(d)
+
+
+class TestRejections(unittest.TestCase):
+    def test_missing_sku_rejected_and_unchanged(self):
+        db, d = fixture([("A", 2)])
+        try:
+            with self.assertRaises(ValueError):
+                dispatch({"action": "adjust", "db": db, "changes": [{"sku": "Z", "delta": 1}]})
+            self.assertEqual(rows_of(db), [("A", 2)])
+        finally:
+            shutil.rmtree(d)
+
+    def test_unknown_action_raises_value_error(self):
+        db, d = fixture([("A", 2)])
+        try:
+            with self.assertRaises(ValueError):
+                dispatch({"action": "bogus", "db": db})
+        finally:
+            shutil.rmtree(d)
+
+    def test_snapshot_preserved(self):
+        db, d = fixture([("B", 1), ("A", 2)])
+        try:
+            self.assertEqual(
+                dispatch({"action": "snapshot", "db": db}),
+                [{"sku": "A", "quantity": 2}, {"sku": "B", "quantity": 1}],
+            )
+        finally:
+            shutil.rmtree(d)
+
+
+class TestCli(unittest.TestCase):
+    def run_cli(self, payload):
+        return subprocess.run(
+            [sys.executable, os.path.join(ROOT, "cli.py")],
+            input=json.dumps(payload),
+            capture_output=True,
+            text=True,
+        )
+
+    def test_cli_success_json_exit_0(self):
+        db, d = fixture([("A", 3)])
+        try:
+            proc = self.run_cli({"action": "adjust", "db": db, "changes": [{"sku": "A", "delta": -1}]})
+            self.assertEqual(proc.returncode, 0)
+            self.assertEqual(proc.stderr, "")
+            self.assertEqual(json.loads(proc.stdout), [{"sku": "A", "quantity": 2}])
+        finally:
+            shutil.rmtree(d)
+
+    def test_cli_value_error_exit_2_stderr(self):
+        db, d = fixture([("A", 3)])
+        try:
+            proc = self.run_cli({"action": "nope", "db": db})
+            self.assertEqual(proc.returncode, 2)
+            self.assertTrue(proc.stderr.strip())
+            self.assertNotIn("Traceback", proc.stderr)
+        finally:
+            shutil.rmtree(d)
+
+
+if __name__ == "__main__":
+    unittest.main()
