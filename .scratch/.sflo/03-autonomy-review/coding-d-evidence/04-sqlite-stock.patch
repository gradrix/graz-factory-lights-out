+def adjust(p):
+    con=sqlite3.connect(p['db'])
+    try:
+        try:
+            current={s:q for s,q in con.execute('SELECT sku,quantity FROM stock').fetchall()}
+            for change in p['changes']:
+                sku=change['sku']
+                if sku not in current:
+                    raise ValueError("unknown sku: "+repr(sku))
+                quantity=current[sku]+change['delta']
+                if quantity<0:
+                    raise ValueError("quantity for sku "+repr(sku)+" would become negative: "+str(quantity))
+                current[sku]=quantity
+                con.execute('UPDATE stock SET quantity=? WHERE sku=?',(quantity,sku))
+            con.commit()
+        except ValueError:
+            con.rollback()
+            raise
+        return [{'sku':s,'quantity':q} for s,q in sorted(con.execute('SELECT sku,quantity FROM stock').fetchall())]
+    finally:
+        con.close()
