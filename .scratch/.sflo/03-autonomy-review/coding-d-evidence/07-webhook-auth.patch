@@ -0,0 +1,98 @@
+import hmac
+import hashlib
+import unittest
+import api
+
+
+def _digest(secret, timestamp, body):
+    return hmac.new(secret.encode('utf-8'),
+                    (str(timestamp) + '.' + body).encode('utf-8'),
+                    hashlib.sha256).hexdigest()
+
+
+class VerifyNormal(unittest.TestCase):
+    def test_verify_valid_signature_within_tolerance(self):
+        payload = {"action": "verify",
+                   "secret": "s3cret",
+                   "body": "hello wörld",
+                   "timestamp": 1000,
+                   "now": 1005,
+                   "tolerance": 60,
+                   "signature": "sha256=" + _digest("s3cret", 1000, "hello wörld")}
+        result = api.dispatch(payload)
+        self.assertIs(result, True)
+        # input object must not be mutated
+        self.assertEqual(payload["signature"], "sha256=" + _digest("s3cret", 1000, "hello wörld"))
+
+    def test_verify_existing_action_preserved(self):
+        self.assertEqual(api.dispatch({"action": "body_bytes", "body": "héllo"}), 6)
+
+
+class VerifyBoundaries(unittest.TestCase):
+    def test_verify_tolerance_boundary_exact(self):
+        # abs(now - timestamp) == tolerance is accepted (inclusive boundary)
+        payload = {"action": "verify",
+                   "secret": "k",
+                   "body": "",
+                   "timestamp": 0,
+                   "now": 3600,
+                   "tolerance": 3600,
+                   "signature": "sha256=" + _digest("k", 0, "")}
+        self.assertIs(api.dispatch(payload), True)
+
+    def test_verify_max_timestamp_boundary(self):
+        # timestamp == 2**40 upper bound works with plain decimal digits
+        t = 2 ** 40
+        payload = {"action": "verify",
+                   "secret": "k",
+                   "body": "b",
+                   "timestamp": t,
+                   "now": t,
+                   "tolerance": 0,
+                   "signature": "sha256=" + _digest("k", t, "b")}
+        self.assertIs(api.dispatch(payload), True)
+
+    def test_verify_uppercase_hex_rejected(self):
+        # well-formed prefix but uppercase hex is not lowercase: rejected, no exception
+        payload = {"action": "verify",
+                   "secret": "k",
+                   "body": "b",
+                   "timestamp": 1,
+                   "now": 1,
+                   "tolerance": 0,
+                   "signature": ("sha256=" + _digest("k", 1, "b")).upper().replace("SHA256=", "sha256=")}
+        self.assertIs(api.dispatch(payload), False)
+
+
+class VerifyRejections(unittest.TestCase):
+    def test_verify_outside_tolerance_false(self):
+        payload = {"action": "verify",
+                   "secret": "k",
+                   "body": "b",
+                   "timestamp": 100,
+                   "now": 101,
+                   "tolerance": 0,
+                   "signature": "sha256=" + _digest("k", 100, "b")}
+        self.assertIs(api.dispatch(payload), False)
+
+    def test_verify_malformed_signature_no_exception(self):
+        for bad in ["", "sha256=", "sha256=" + "z" * 64, "sha256=" + _digest("k", 1, "b") + "é",
+                    "SHA256=" + _digest("k", 1, "b"), _digest("k", 1, "b")]:
+            payload = {"action": "verify", "secret": "k", "body": "b",
+                       "timestamp": 1, "now": 1, "tolerance": 0, "signature": bad}
+            self.assertIs(api.dispatch(payload), False)
+
+    def test_verify_wrong_secret_false(self):
+        payload = {"action": "verify", "secret": "k", "body": "b",
+                   "timestamp": 1, "now": 1, "tolerance": 0,
+                   "signature": "sha256=" + _digest("other", 1, "b")}
+        self.assertIs(api.dispatch(payload), False)
+
+    def test_unknown_action_raises_valueerror(self):
+        with self.assertRaises(ValueError) as cm:
+            api.dispatch({"action": "nope"})
+        self.assertEqual(str(cm.exception), "unknown action: nope")
+
+
+if __name__ == '__main__':
+    unittest.main()
