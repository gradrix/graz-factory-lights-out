@@ -1 +1,37 @@
-def legacy(p):return len(p['body'].encode('utf-8'))
+import hmac
+import hashlib
+
+
+def legacy(p):
+    return len(p['body'].encode('utf-8'))
+
+
+def verify(p):
+    """Return True iff the signature matches the HMAC and the timestamp is within tolerance.
+
+    Signed string: decimal timestamp + "." + body, HMAC-SHA256 keyed with UTF-8 secret.
+    Signature must be exactly "sha256=" + 64 lowercase hex characters.
+    """
+    secret = p['secret']
+    body = p['body']
+    timestamp = p['timestamp']
+    now = p['now']
+    tolerance = p['tolerance']
+    signature = p['signature']
+
+    digest = hmac.new(secret.encode('utf-8'),
+                      (str(timestamp) + '.' + body).encode('utf-8'),
+                      hashlib.sha256).hexdigest()
+
+    # Malformed (not well-formed) signatures are rejected without comparison.
+    if len(signature) != 71 or not signature.startswith('sha256='):
+        return False
+    hexpart = signature[7:]
+    if not all(c in '0123456789abcdef' for c in hexpart):
+        return False
+
+    # Timing-safe comparison for well-formed signatures.
+    if not hmac.compare_digest(hexpart, digest):
+        return False
+
+    return abs(now - timestamp) <= tolerance
--- a/tests/test_public.py
