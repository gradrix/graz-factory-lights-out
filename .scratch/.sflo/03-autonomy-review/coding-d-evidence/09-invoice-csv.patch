+import json
+import subprocess
+import unittest
+import copy
+
+import api
+import domain
+
+
+class ExportTests(unittest.TestCase):
+    def test_invoices_list_normal(self):
+        payload = {
+            "action": "export",
+            "invoices": [
+                {"id": "a1", "customer": "Acme, Co",
+                 "items": [{"quantity": 2, "unit_cents": 1550},
+                           {"quantity": 0, "unit_cents": 999}]},
+                {"id": 'q"1', "customer": "line\nbreak", "items": []},
+            ],
+        }
+        original = copy.deepcopy(payload)
+        csv = api.dispatch(payload)
+        self.assertEqual(payload, original)  # input never mutated
+        self.assertEqual(
+            csv,
+            'id,customer,total\r\n'
+            'a1,"Acme, Co",31.00\r\n'
+            '"q""1","line\nbreak",0.00\r\n')
+
+    def test_boundaries(self):
+        # Empty invoices still returns the header (with trailing CRLF).
+        empty = api.dispatch({"action": "export", "invoices": []})
+        self.assertEqual(empty, "id,customer,total\r\n")
+        # Max quantity/unit_cents: 100 items * 1000 * 1000000 cents = exact.
+        big = api.dispatch({
+            "action": "export",
+            "invoices": [{
+                "id": "x", "customer": "c",
+                "items": [{"quantity": 1000, "unit_cents": 1000000}] * 100,
+            }],
+        })
+        self.assertEqual(
+            big,
+            'id,customer,total\r\n'
+            'x,c,1000000000.00\r\n')
+        # 100 invoices boundary: every row present, input order preserved.
+        many = api.dispatch({
+            "action": "export",
+            "invoices": [{"id": str(i), "customer": "c", "items": []}
+                         for i in range(100)],
+        })
+        rows = many.split("\r\n")
+        self.assertEqual(rows[0], "id,customer,total")
+        self.assertEqual(len(rows), 102)  # header + 100 rows + trailing ''
+        self.assertEqual(rows[1], "0,c,0.00")
+        self.assertEqual(rows[100], "99,c,0.00")
+
+    def test_unknown_action_rejected(self):
+        for action in ("nope", "invoices:list "):
+            with self.assertRaises(ValueError) as raised:
+                api.dispatch({"action": action, "invoices": []})
+            self.assertEqual(str(raised.exception), "unknown action: " + action)
+
+    def test_cli_json_behavior(self):
+        payload = {"action": "export",
+                   "invoices": [{"id": "a,b", "customer": 'C"R',
+                                 "items": [{"quantity": 1, "unit_cents": 5}]}]}
+        proc = subprocess.run(
+            ["python", "-B", "-I", "cli.py"],
+            input=json.dumps(payload).encode(),
+            capture_output=True, cwd=".", timeout=30)
+        self.assertEqual(proc.returncode, 0)
+        expected_csv = 'id,customer,total\r\n"a,b","C""R",0.05\r\n'
+        self.assertEqual(proc.stdout,
+                         (json.dumps(expected_csv, ensure_ascii=False) + "\n").encode())
+        self.assertEqual(proc.stderr, b"")
+        bad = subprocess.run(
+            ["python", "-B", "-I", "cli.py"],
+            input=json.dumps({"action": "bogus"}).encode(),
+            capture_output=True, cwd=".", timeout=30)
+        self.assertEqual(bad.returncode, 2)
+        self.assertEqual(bad.stderr, b"unknown action: bogus\n")
+        self.assertEqual(bad.stdout, b"")
+
+    def test_legacy_action_preserved(self):
+        payload = {"action": "invoice_ids",
+                   "invoices": [{"id": "z"}, {"id": "y"}]}
+        original = copy.deepcopy(payload)
+        self.assertEqual(api.dispatch(payload), ["z", "y"])
+        self.assertEqual(payload, original)
+
+
+if __name__ == "__main__":
+    unittest.main()
