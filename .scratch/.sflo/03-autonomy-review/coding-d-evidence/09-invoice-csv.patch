-def legacy(p):return [x['id'] for x in p['invoices']]
+"""Domain actions for the invoice exporter."""
+
+def legacy(payload):
+    return [x['id'] for x in payload['invoices']]
+
+def _encode(value):
+    """Encode a str/bool/int/float exactly as parsed from JSON input."""
+    if value is True or value is False:
+        return 'true' if value else 'false'
+    if isinstance(value, str):
+        return value
+    if isinstance(value, int):
+        return repr(value)
+    if isinstance(value, float):
+        return _json_float(value)
+    return str(value)
+
+def _json_float(value):
+    import json
+    return json.dumps(value, ensure_ascii=False, allow_nan=False)
+
+def _quote(field):
+    if any(c in field for c in ',"\r\n'):
+        return '"' + field.replace('"', '""') + '"'
+    return field
+
+def invoices_list(payload):
+    """Render payload['invoices'] as a CSV string (header + one row per invoice).
+
+    total is the exact sum of quantity*unit_cents (cents), printed in currency
+    units with exactly two fractional digits. Text fields are emitted verbatim
+    (no normalization) with standard CSV quoting; every record ends with CRLF.
+    """
+    lines = ['id,customer,total\r\n']
+    for invoice in payload['invoices']:
+        cents = 0
+        for item in invoice['items']:
+            cents += item['quantity'] * item['unit_cents']
+        total = str(cents // 100) + '.' + str(cents % 100).zfill(2)
+        fields = (_encode(invoice['id']), _encode(invoice['customer']), total)
+        lines.append(','.join(_quote(f) for f in fields) + '\r\n')
+    return ''.join(lines)
