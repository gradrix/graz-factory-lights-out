@@ -0,0 +1,102 @@
+import json
+import subprocess
+import sys
+import unittest
+
+import api
+
+
+class ReadinessTests(unittest.TestCase):
+    def test_normal_case_last_check_wins(self):
+        payload = {
+            "action": "readiness",
+            "required": ["alpha", "beta"],
+            "checks": [
+                {"service": "alpha", "state": "down", "critical": True},
+                {"service": "alpha", "state": "up", "critical": False},
+                {"service": "beta", "state": "down", "critical": False},
+                {"service": "gamma", "state": "up", "critical": False},
+            ],
+            "quorum": 2,
+        }
+        result = api.dispatch(payload)
+        self.assertEqual(result, {"ready": False, "up": 2, "blockers": ["beta"]})
+        # alpha's earlier critical/down flag is replaced by its last up check.
+        self.assertIs(result["ready"], False)
+        self.assertIsInstance(result["up"], int)
+
+    def test_boundary_quorum_equal_and_empty_input(self):
+        payload = {
+            "action": "readiness",
+            "required": ["a", "b"],
+            "checks": [
+                {"service": "a", "state": "up", "critical": False},
+                {"service": "b", "state": "up", "critical": False},
+                {"service": "extra", "state": "up", "critical": False},
+            ],
+            "quorum": 3,
+        }
+        result = api.dispatch(payload)
+        self.assertEqual(result, {"ready": True, "up": 3, "blockers": []})
+        empty = {"action": "readiness", "required": [], "checks": [], "quorum": 0}
+        self.assertEqual(api.dispatch(empty), {"ready": True, "up": 0, "blockers": []})
+
+    def test_missing_required_and_critical_blockers_sorted(self):
+        payload = {
+            "action": "readiness",
+            "required": ["zulu", "missing"],
+            "checks": [
+                {"service": "zulu", "state": "unknown", "critical": False},
+                {"service": "missing", "state": "up", "critical": False},
+                {"service": "missing", "state": "down", "critical": True},
+                {"service": "aux", "state": "down", "critical": True},
+                {"service": "aux", "state": "up", "critical": True},
+            ],
+            "quorum": 1,
+        }
+        result = api.dispatch(payload)
+        # missing's last check is down+critical; aux's last check is up so its
+        # critical flag does not block. zulu is unknown -> blocker.
+        self.assertEqual(result, {"ready": False, "up": 1, "blockers": ["missing", "zulu"]})
+
+    def test_unknown_action_rejected(self):
+        with self.assertRaises(ValueError) as ctx:
+            api.dispatch({"action": "nope", "required": [], "checks": [], "quorum": 0})
+        self.assertEqual(str(ctx.exception), "unknown action: nope")
+
+    def test_input_never_mutated(self):
+        payload = {
+            "action": "readiness",
+            "required": ["a"],
+            "checks": [{"service": "a", "state": "up", "critical": False}],
+            "quorum": 1,
+        }
+        snapshot = json.dumps(payload, sort_keys=True)
+        api.dispatch(payload)
+        self.assertEqual(json.dumps(payload, sort_keys=True), snapshot)
+
+    def test_cli_json_success_and_valueerror_exit(self):
+        proc = subprocess.run(
+            [sys.executable, "cli.py"],
+            input=json.dumps({"action": "check_names", "checks": [{"service": "s"}]}),
+            capture_output=True,
+            text=True,
+            cwd=".",
+        )
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(proc.stdout.strip(), '["s"]')
+        self.assertEqual(proc.stderr, "")
+        proc = subprocess.run(
+            [sys.executable, "cli.py"],
+            input=json.dumps({"action": "boom"}),
+            capture_output=True,
+            text=True,
+            cwd=".",
+        )
+        self.assertEqual(proc.returncode, 2)
+        self.assertEqual(proc.stderr, "unknown action: boom\n")
+        self.assertEqual(proc.stdout, "")
+
+
+if __name__ == "__main__":
+    unittest.main()
