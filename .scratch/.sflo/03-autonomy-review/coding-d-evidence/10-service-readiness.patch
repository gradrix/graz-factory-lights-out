--- a/domain.py
+++ b/domain.py
@@ -1 +1,18 @@
 def legacy(p):return [c['service'] for c in p['checks']]
+
+def readiness(p):
+    last = {}
+    for c in p['checks']:
+        last[c['service']] = c
+    up = 0
+    blockers = set()
+    for svc, c in last.items():
+        if c['state'] == 'up':
+            up += 1
+        elif c['critical'] is True:
+            blockers.add(svc)
+    for svc in p['required']:
+        c = last.get(svc)
+        if c is None or c['state'] != 'up':
+            blockers.add(svc)
+    return {'ready': up >= p['quorum'] and not blockers, 'up': up, 'blockers': sorted(blockers)}
