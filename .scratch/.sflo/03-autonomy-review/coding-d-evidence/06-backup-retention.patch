@@ -1 +1,19 @@
 def legacy(p):return [b['id'] for b in p['backups']]
+
+def plan(p):
+    backups=p['backups']
+    days=p['days']
+    keep_ids=set()
+    by_service={}
+    for b in backups:
+        by_service.setdefault(b['service'],[]).append(b)
+    for items in by_service.values():
+        by_date={}
+        for b in items:
+            by_date.setdefault(b['finished'][:10],[]).append(b)
+        for date in sorted(by_date,reverse=True)[:days]:
+            candidates=by_date[date]
+            latest=max(b['finished'] for b in candidates)
+            best=min((b for b in candidates if b['finished']==latest),key=lambda b:b['id'])
+            keep_ids.add(best['id'])
+    return {'keep':[b['id'] for b in backups if b['id'] in keep_ids],'delete':[b['id'] for b in backups if b['id'] not in keep_ids]}
