@@ -0,0 +1,117 @@
+import json
+import subprocess
+import unittest
+
+from api import dispatch
+
+
+class PlanNormalCase(unittest.TestCase):
+    def test_normal_case_multiple_services(self):
+        payload = {
+            "action": "plan",
+            "days": 2,
+            "backups": [
+                {"id": "a1", "service": "web", "finished": "2024-01-05T10:00:00Z"},
+                {"id": "a2", "service": "web", "finished": "2024-01-04T10:00:00Z"},
+                {"id": "a3", "service": "web", "finished": "2024-01-03T10:00:00Z"},
+                {"id": "b1", "service": "db", "finished": "2024-01-02T08:00:00Z"},
+                {"id": "b2", "service": "db", "finished": "2024-01-05T09:00:00Z"},
+            ],
+        }
+        result = dispatch(payload)
+        # web keeps newest two dates (01-05, 01-04); db keeps its only two dates
+        self.assertEqual(result, {"keep": ["a1", "a2", "b1", "b2"], "delete": ["a3"]})
+        # both lists must follow original input order
+        ids_in_order = [b["id"] for b in payload["backups"]]
+        for key in ("keep", "delete"):
+            self.assertEqual(result[key], [i for i in ids_in_order if i in set(result[key])])
+
+
+class PlanBoundaries(unittest.TestCase):
+    def test_days_zero_deletes_all(self):
+        payload = {
+            "action": "plan",
+            "days": 0,
+            "backups": [
+                {"id": "x", "service": "web", "finished": "2024-01-05T10:00:00Z"},
+                {"id": "y", "service": "web", "finished": "2024-01-04T10:00:00Z"},
+            ],
+        }
+        result = dispatch(payload)
+        self.assertEqual(result, {"keep": [], "delete": ["x", "y"]})
+
+    def test_days_above_distinct_dates_keeps_one_per_date(self):
+        payload = {
+            "action": "plan",
+            "days": 30,
+            "backups": [
+                {"id": "p", "service": "web", "finished": "2024-01-05T10:00:00Z"},
+                {"id": "q", "service": "web", "finished": "2024-01-05T23:59:59Z"},
+                {"id": "r", "service": "web", "finished": "2000-01-01T00:00:00Z"},
+            ],
+        }
+        result = dispatch(payload)
+        # one kept per date: latest on 01-05 is q (23:59:59), r is only backup on 01-01
+        self.assertEqual(result, {"keep": ["q", "r"], "delete": ["p"]})
+
+    def test_identical_timestamps_keep_smallest_id(self):
+        payload = {
+            "action": "plan",
+            "days": 1,
+            "backups": [
+                {"id": "zz", "service": "web", "finished": "2024-01-05T10:00:00Z"},
+                {"id": "aa", "service": "web", "finished": "2024-01-05T10:00:00Z"},
+                {"id": "mm", "service": "web", "finished": "2024-01-05T10:00:00Z"},
+            ],
+        }
+        result = dispatch(payload)
+        self.assertEqual(result, {"keep": ["aa"], "delete": ["zz", "mm"]})
+
+    def test_input_not_mutated(self):
+        payload = {
+            "action": "plan",
+            "days": 1,
+            "backups": [{"id": "a", "service": "web", "finished": "2024-01-05T10:00:00Z"}],
+        }
+        snapshot = json.dumps(payload, sort_keys=True)
+        dispatch(payload)
+        self.assertEqual(json.dumps(payload, sort_keys=True), snapshot)
+
+
+class CliErrors(unittest.TestCase):
+    def test_unknown_action_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            dispatch({"action": "nope", "backups": [], "days": 0})
+
+    def test_cli_exit_2_on_unknown_action(self):
+        proc = subprocess.run(
+            ["python", "-B", "-I", "cli.py"],
+            input=json.dumps({"action": "nope"}),
+            capture_output=True,
+            text=True,
+
+        )
+        self.assertEqual(proc.returncode, 2)
+        self.assertNotEqual(proc.stderr.strip(), "")
+        self.assertNotIn("Traceback", proc.stderr)
+        self.assertEqual(proc.stdout, "")
+
+    def test_cli_success_json_roundtrip(self):
+        payload = {
+            "action": "plan",
+            "days": 1,
+            "backups": [{"id": "a", "service": "web", "finished": "2024-01-05T10:00:00Z"}],
+        }
+        proc = subprocess.run(
+            ["python", "-B", "-I", "cli.py"],
+            input=json.dumps(payload),
+            capture_output=True,
+            text=True,
+
+        )
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(json.loads(proc.stdout), {"keep": ["a"], "delete": []})
+
+
+if __name__ == "__main__":
+    unittest.main()
