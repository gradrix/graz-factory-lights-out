-def legacy(p):return sorted(p['variables'])
+import re
+
+_NAME_RE = re.compile(r'[A-Za-z_][A-Za-z0-9_]*')
+
+def legacy(p):
+    return sorted(p['variables'])
+
+def render(p):
+    template = p['template']
+    variables = p['variables']
+    if len(template) > 4000:
+        raise ValueError('template exceeds 4000 code points')
+    if len(variables) > 100:
+        raise ValueError('variables exceed 100 names')
+    for name, value in variables.items():
+        if len(value) > 1000:
+            raise ValueError('variable value exceeds 1000 code points')
+    out = []
+    i = 0
+    n = len(template)
+    while i < n:
+        c = template[i]
+        if c != '$':
+            out.append(c)
+            i += 1
+            continue
+        if i + 1 >= n:
+            raise ValueError('dollar sign not followed by dollar or opening brace')
+        nxt = template[i + 1]
+        if nxt == '$':
+            out.append('$')
+            i += 2
+            continue
+        if nxt != '{':
+            raise ValueError('dollar sign not followed by dollar or opening brace')
+        m = _NAME_RE.match(template, i + 2)
+        if not m:
+            raise ValueError('malformed variable name')
+        j = m.end()
+        if j >= n or template[j] != '}':
+            raise ValueError('missing closing brace')
+        name = m.group(0)
+        if name not in variables:
+            raise ValueError('undefined variable: ' + name)
+        out.append(variables[name])
+        i = j + 1
+    return ''.join(out)
