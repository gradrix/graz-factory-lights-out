+import unittest
+from api import dispatch
+
+
+class RenderTests(unittest.TestCase):
+    def test_normal_render_with_escape_and_single_pass(self):
+        # Normal case: substitution, escaped dollar, single-pass semantics.
+        payload = {
+            "action": "render",
+            "template": "a ${X} b $$ c ${Y}\nend",
+            "variables": {"X": "${Y}", "Y": "$"},
+        }
+        result = dispatch(payload)
+        # Value text is never re-expanded; $$ emits one literal dollar.
+        self.assertEqual(result, "a ${Y} b $ c $\nend")
+
+    def test_boundaries(self):
+        # Boundary: empty template is valid; 4000-codepoint template renders.
+        self.assertEqual(
+            dispatch({"action": "render", "template": "", "variables": {}}),
+            "",
+        )
+        big = "x" * 4000
+        self.assertEqual(
+            dispatch({"action": "render", "template": big, "variables": {}}),
+            big,
+        )
+        # $${X} yields literal ${X} (escaped dollar consumes two characters).
+        self.assertEqual(
+            dispatch({"action": "render", "template": "$${X}", "variables": {"X": "v"}}),
+            "${X}",
+        )
+
+    def test_specified_rejections(self):
+        # Specified rejections raise ValueError.
+        for template in ("$", "hello $", "${X", "${1X}", "${X", "no $ here? $!"):
+            with self.assertRaises(ValueError):
+                dispatch({"action": "render", "template": template, "variables": {"X": "v"}})
+        with self.assertRaises(ValueError):
+            dispatch({"action": "render", "template": "${MISSING}", "variables": {}})
+
+    def test_existing_variable_names_preserved(self):
+        self.assertEqual(
+            dispatch({"action": "variable_names", "variables": {"b": "1", "a": "2"}}),
+            ["a", "b"],
+        )
+
+    def test_unknown_action_rejected(self):
+        with self.assertRaises(ValueError):
+            dispatch({"action": "nope", "variables": {}})
+
+    def test_input_not_mutated_on_failure(self):
+        payload = {"action": "render", "template": "${X} $", "variables": {"X": "keep"}}
+        try:
+            dispatch(payload)
+        except ValueError:
+            pass
+        self.assertEqual(payload["variables"], {"X": "keep"})
+        self.assertEqual(payload["template"], "${X} $")
+
+
+if __name__ == "__main__":
+    unittest.main()
