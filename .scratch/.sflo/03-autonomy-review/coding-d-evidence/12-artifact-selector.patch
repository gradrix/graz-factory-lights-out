@@ -0,0 +1,127 @@
+import json
+import subprocess
+import unittest
+from api import dispatch
+
+
+class SelectActionTests(unittest.TestCase):
+    def test_select_normal_case(self):
+        payload = {
+            "action": "select",
+            "platform": "linux",
+            "major": 2,
+            "artifacts": [
+                {"id": "b", "platform": "linux", "version": "2.10.3", "yanked": False},
+                {"id": "c", "platform": "linux", "version": "2.9.9", "yanked": False},
+                {"id": "d", "platform": "win", "version": "2.9.9", "yanked": False},
+                {"id": "e", "platform": "linux", "version": "3.0.0", "yanked": False},
+                {"id": "f", "platform": "linux", "version": "2.10.3", "yanked": True},
+            ],
+        }
+        original = json.loads(json.dumps(payload))
+        result = dispatch(payload)
+        self.assertEqual(result, {"id": "b", "version": "2.10.3"})
+        self.assertEqual(payload, original)
+
+    def test_select_boundary_versions_and_major_bounds(self):
+        payload = {
+            "action": "select",
+            "platform": "linux",
+            "major": 1000,
+            "artifacts": [
+                {"id": "hi", "platform": "linux", "version": "1000.1000.1000", "yanked": False},
+                {"id": "lo", "platform": "linux", "version": "0.0.0", "yanked": False},
+            ],
+        }
+        self.assertEqual(
+            dispatch(payload), {"id": "hi", "version": "1000.1000.1000"}
+        )
+        payload = {
+            "action": "select",
+            "platform": "linux",
+            "major": 0,
+            "artifacts": [
+                {"id": "hi", "platform": "linux", "version": "1000.1000.1000", "yanked": False},
+                {"id": "lo", "platform": "linux", "version": "0.0.0", "yanked": False},
+            ],
+        }
+        self.assertEqual(dispatch(payload), {"id": "lo", "version": "0.0.0"})
+
+    def test_select_numeric_minor_ordering(self):
+        payload = {
+            "action": "select",
+            "platform": "linux",
+            "major": 2,
+            "artifacts": [
+                {"id": "nine", "platform": "linux", "version": "2.9.9", "yanked": False},
+                {"id": "ten", "platform": "linux", "version": "2.10.0", "yanked": False},
+            ],
+        }
+        self.assertEqual(dispatch(payload), {"id": "ten", "version": "2.10.0"})
+
+    def test_select_tie_break_smallest_id_regardless_of_input_order(self):
+        a = {"id": "a", "platform": "linux", "version": "2.1.1", "yanked": False}
+        b = {"id": "B", "platform": "linux", "version": "2.1.1", "yanked": False}
+        c = {"id": "z9", "platform": "linux", "version": "2.1.1", "yanked": False}
+        base = {"action": "select", "platform": "linux", "major": 2}
+        for order in ([a, b, c], [c, b, a], [b, c, a]):
+            payload = dict(base, artifacts=order)
+            self.assertEqual(dispatch(payload), {"id": "B", "version": "2.1.1"})
+
+    def test_select_returns_null_when_no_eligible_artifact(self):
+        payload = {
+            "action": "select",
+            "platform": "linux",
+            "major": 2,
+            "artifacts": [
+                {"id": "d", "platform": "win", "version": "2.9.9", "yanked": False},
+                {"id": "e", "platform": "linux", "version": "3.0.0", "yanked": False},
+                {"id": "f", "platform": "linux", "version": "2.10.3", "yanked": True},
+            ],
+        }
+        self.assertIsNone(dispatch(payload))
+        self.assertIsNone(dispatch({"action": "select", "platform": "linux", "major": 0, "artifacts": []}))
+
+    def test_existing_action_artifact_ids_preserved(self):
+        payload = {"action": "artifact_ids", "artifacts": [{"id": "x"}, {"id": "y"}]}
+        self.assertEqual(dispatch(payload), ["x", "y"])
+
+    def test_unknown_action_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            dispatch({"action": "nope"})
+
+    def test_cli_success_json_stdout_exit_zero(self):
+        payload = {
+            "action": "select",
+            "platform": "linux",
+            "major": 2,
+            "artifacts": [
+                {"id": "b", "platform": "linux", "version": "2.10.3", "yanked": False},
+                {"id": "a", "platform": "linux", "version": "2.10.3", "yanked": False},
+            ],
+        }
+        proc = subprocess.run(
+            ["python", "cli.py"],
+            input=json.dumps(payload),
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(proc.stderr, "")
+        self.assertEqual(json.loads(proc.stdout), {"id": "a", "version": "2.10.3"})
+
+    def test_cli_value_error_exit_two_nonempty_stderr_no_traceback(self):
+        proc = subprocess.run(
+            ["python", "cli.py"],
+            input=json.dumps({"action": "nope"}),
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual(proc.returncode, 2)
+        self.assertTrue(proc.stderr)
+        self.assertNotIn("Traceback", proc.stderr)
+        self.assertEqual(proc.stdout, "")
+
+
+if __name__ == "__main__":
+    unittest.main()
