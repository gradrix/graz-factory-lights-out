--- a/domain.py
+++ b/domain.py
@@ -1 +1,20 @@
 def legacy(p):return [a['id'] for a in p['artifacts']]
+
+
+def _version_tuple(version):
+    major,minor,patch=version.split('.')
+    return (int(major),int(minor),int(patch))
+
+def select(p):
+    best=None
+    best_key=None
+    for a in p['artifacts']:
+        if a['platform']!=p['platform']:continue
+        if a['yanked'] is not False:continue
+        key=_version_tuple(a['version'])
+        if key[0]!=p['major']:continue
+        if best is None or key>best_key or (key==best_key and a['id']<best['id']):
+            best=a
+            best_key=key
+    if best is None:return None
+    return {'id':best['id'],'version':best['version']}
