+import copy
+
 def keys(payload):
     return sorted(payload['config'])
+
+
+def _merge(old, new):
+    """Recursively merge layer `new` into base `old`, returning a new object.
+
+    Objects merge recursively; arrays and scalars replace entirely. A null
+    in a layer deletes the key if present (at any depth); deleting an absent
+    key is a no-op. Nulls already present in the base survive unless a layer
+    overrides or deletes them. Objects introduced where no old object exists
+    are built against an empty object, so their nested nulls only delete.
+    Inputs are never mutated.
+    """
+    if not isinstance(new, dict):
+        return copy.deepcopy(new)
+    base = old if isinstance(old, dict) else {}
+    result = {}
+    for key, value in base.items():
+        if key in new:
+            layer_value = new[key]
+            if layer_value is None:
+                continue  # null in layer deletes the key
+            result[key] = _merge(value, layer_value)
+        else:
+            result[key] = value
+    for key, value in new.items():
+        if key not in base:
+            if value is None:
+                continue  # deleting an absent key is a no-op
+            result[key] = _merge({}, value) if isinstance(value, dict) else copy.deepcopy(value)
+    return result
+
+
+def resolve(payload):
+    result = copy.deepcopy(payload['defaults'])
+    for layer in payload['layers']:
+        result = _merge(result, layer)
+    for key in payload['required']:
+        if key not in result:
+            raise ValueError("missing required key: " + str(key))
+    return result
