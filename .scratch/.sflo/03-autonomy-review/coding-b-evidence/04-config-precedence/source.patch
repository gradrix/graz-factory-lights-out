@@ -0,0 +1,210 @@
+import json
+import os
+import subprocess
+import sys
+import unittest
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+import api
+import domain
+
+class TestResolve(unittest.TestCase):
+    def test_later_layers_win(self):
+        payload = {
+            "action": "resolve",
+            "defaults": {"a": 1, "b": 2},
+            "layers": [{"b": 3}, {"a": 10}],
+            "required": ["a", "b"],
+        }
+        self.assertEqual(domain.resolve(payload), {"a": 10, "b": 3})
+
+    def test_recursive_object_merge(self):
+        payload = {
+            "action": "resolve",
+            "defaults": {"cfg": {"x": 1, "y": 2}},
+            "layers": [{"cfg": {"y": 20, "z": 3}}],
+            "required": ["cfg"],
+        }
+        self.assertEqual(
+            domain.resolve(payload),
+            {"cfg": {"x": 1, "y": 20, "z": 3}},
+        )
+
+    def test_arrays_and_scalars_replace_entirely(self):
+        payload = {
+            "action": "resolve",
+            "defaults": {"list": [1, 2, 3], "deep": {"a": {"b": 1}}},
+            "layers": [{"list": [9], "deep": {"a": [7]}}],
+            "required": [],
+        }
+        self.assertEqual(
+            domain.resolve(payload),
+            {"list": [9], "deep": {"a": [7]}},
+        )
+
+    def test_null_deletes_present_key(self):
+        payload = {
+            "action": "resolve",
+            "defaults": {"a": 1, "b": 2},
+            "layers": [{"a": None}],
+            "required": ["b"],
+        }
+        self.assertEqual(domain.resolve(payload), {"b": 2})
+
+    def test_null_deletion_at_nested_depth(self):
+        payload = {
+            "action": "resolve",
+            "defaults": {"cfg": {"x": 1, "y": {"m": 1, "n": 2}}},
+            "layers": [{"cfg": {"y": {"m": None}}}],
+            "required": ["cfg"],
+        }
+        self.assertEqual(
+            domain.resolve(payload),
+            {"cfg": {"x": 1, "y": {"n": 2}}},
+        )
+
+    def test_deleting_absent_key_is_noop(self):
+        payload = {
+            "action": "resolve",
+            "defaults": {},
+            "layers": [{"missing": None}, {"a": {"b": None}}],
+            "required": [],
+        }
+        # "missing" deletion is a no-op; "a" is introduced as an object
+        # merged against an empty object, so its nested null deletes
+        # nothing and leaves an empty object behind.
+        self.assertEqual(domain.resolve(payload), {"a": {}})
+
+    def test_nested_nulls_apply_against_empty_object(self):
+        payload = {
+            "action": "resolve",
+            "defaults": {},
+            "layers": [{"cfg": {"keep": 1, "drop": None}}],
+            "required": ["cfg"],
+        }
+        self.assertEqual(domain.resolve(payload), {"cfg": {"keep": 1}})
+
+    def test_nulls_in_defaults_survive(self):
+        payload = {
+            "action": "resolve",
+            "defaults": {"a": None, "cfg": {"x": None}},
+            "layers": [{"cfg": {"y": 1}}],
+            "required": ["a", "cfg"],
+        }
+        self.assertEqual(
+            domain.resolve(payload),
+            {"a": None, "cfg": {"x": None, "y": 1}},
+        )
+
+    def test_null_override_then_replacement(self):
+        payload = {
+            "action": "resolve",
+            "defaults": {"a": 1},
+            "layers": [{"a": None}, {"a": 5}],
+            "required": ["a"],
+        }
+        self.assertEqual(domain.resolve(payload), {"a": 5})
+
+    def test_required_present_null_counts(self):
+        payload = {
+            "action": "resolve",
+            "defaults": {"a": None},
+            "layers": [],
+            "required": ["a"],
+        }
+        self.assertEqual(domain.resolve(payload), {"a": None})
+
+    def test_required_absent_raises(self):
+        payload = {
+            "action": "resolve",
+            "defaults": {"a": 1},
+            "layers": [{"a": None}],
+            "required": ["a"],
+        }
+        with self.assertRaises(ValueError):
+            domain.resolve(payload)
+
+    def test_input_not_mutated(self):
+        defaults = {"cfg": {"x": 1}}
+        layer = {"cfg": {"y": 2, "drop": None}, "gone": None}
+        payload = {
+            "action": "resolve",
+            "defaults": defaults,
+            "layers": [layer],
+            "required": ["cfg"],
+        }
+        result = domain.resolve(payload)
+        self.assertEqual(result, {"cfg": {"x": 1, "y": 2}})
+        self.assertEqual(defaults, {"cfg": {"x": 1}})
+        self.assertEqual(layer, {"cfg": {"y": 2, "drop": None}, "gone": None})
+        bad = {
+            "action": "resolve",
+            "defaults": {"a": 1},
+            "layers": [{"a": None}],
+            "required": ["a"],
+        }
+        try:
+            domain.resolve(bad)
+        except ValueError:
+            pass
+        self.assertEqual(bad["defaults"], {"a": 1})
+        self.assertEqual(bad["layers"], [{"a": None}])
+
+    def test_dispatch_routing(self):
+        payload = {
+            "action": "resolve",
+            "defaults": {"a": 1},
+            "layers": [{"b": 2}],
+            "required": ["a", "b"],
+        }
+        self.assertEqual(api.dispatch(payload), {"a": 1, "b": 2})
+
+    def test_unknown_action_still_raises(self):
+        with self.assertRaises(ValueError):
+            api.dispatch({"action": "nope"})
+
+    def test_existing_keys_action_preserved(self):
+        self.assertEqual(
+            api.dispatch({"action": "keys", "config": {"b": 1, "a": 2}}),
+            ["a", "b"],
+        )
+
+    def test_cli_success(self):
+        payload = {
+            "action": "resolve",
+            "defaults": {"cfg": {"x": 1}},
+            "layers": [{"cfg": {"x": 2, "drop": None}}],
+            "required": ["cfg"],
+        }
+        proc = subprocess.run(
+            [sys.executable, "-B", os.path.join(ROOT, "cli.py")],
+            input=json.dumps(payload),
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(proc.stderr, "")
+        self.assertEqual(json.loads(proc.stdout), {"cfg": {"x": 2}})
+
+    def test_cli_value_error_exit_2(self):
+        payload = {
+            "action": "resolve",
+            "defaults": {},
+            "layers": [],
+            "required": ["missing"],
+        }
+        proc = subprocess.run(
+            [sys.executable, "-B", os.path.join(ROOT, "cli.py")],
+            input=json.dumps(payload),
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual(proc.returncode, 2)
+        self.assertNotEqual(proc.stderr.strip(), "")
+        self.assertNotIn("Traceback", proc.stderr)
+        self.assertEqual(proc.stdout, "")
+
+
+if __name__ == "__main__":
+    unittest.main()
