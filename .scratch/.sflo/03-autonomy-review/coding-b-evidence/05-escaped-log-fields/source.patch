+import re
+
+_KEY_RE = re.compile(r'[A-Za-z_][A-Za-z0-9_]*\Z')
+
 def field_names(payload):
     return sorted(payload['fields'])
+
+def encode(payload):
+    fields = payload['fields']
+    parts = []
+    for key in sorted(fields):
+        if not _KEY_RE.match(key):
+            raise ValueError('invalid key: ' + repr(key))
+        value = fields[key]
+        escaped = (value.replace('\\', '\\\\')
+                   .replace('\t', '\\t')
+                   .replace('\n', '\\n')
+                   .replace('\r', '\\r'))
+        parts.append(key + '=' + escaped)
+    return '\t'.join(parts)
+
+def decode(payload):
+    line = payload['line']
+    if line == '':
+        return {}
+    fields = {}
+    for part in line.split('\t'):
+        if '=' not in part:
+            raise ValueError('field without equals: ' + repr(part))
+        key, sep, value = part.partition('=')
+        if not _KEY_RE.match(key):
+            raise ValueError('invalid key: ' + repr(key))
+        if key in fields:
+            raise ValueError('duplicate key: ' + repr(key))
+        fields[key] = _unescape(value)
+    return fields
+
+def _unescape(value):
+    out = []
+    i = 0
+    while i < len(value):
+        ch = value[i]
+        if ch != '\\':
+            out.append(ch)
+            i += 1
+            continue
+        i += 1
+        if i >= len(value):
+            raise ValueError('trailing backslash in value: ' + repr(value))
+        nxt = value[i]
+        if nxt == '\\':
+            out.append('\\')
+        elif nxt == 't':
+            out.append('\t')
+        elif nxt == 'n':
+            out.append('\n')
+        elif nxt == 'r':
+            out.append('\r')
+        else:
+            raise ValueError('unknown escape: ' + repr(value[i - 1:i + 1]))
+        i += 1
+    return ''.join(out)
