@@ -0,0 +1,118 @@
+import json
+import subprocess
+import unittest
+
+from domain import field_names, encode, decode
+from api import dispatch
+
+
+class EncodeDecode(unittest.TestCase):
+
+    def test_encode_sorted_keys(self):
+        self.assertEqual(encode({'action': 'encode', 'fields': {'b': '2', 'a': '1'}}),
+                         'a=1\tb=2')
+
+    def test_encode_empty_fields(self):
+        self.assertEqual(encode({'action': 'encode', 'fields': {}}), '')
+
+    def test_encode_escapes(self):
+        self.assertEqual(encode({'action': 'encode', 'fields': {'k': 'a\\b\tc\nd\re'}}),
+                         'k=a\\\\b\\tc\\nd\\re')
+
+    def test_encode_does_not_escape_equals_or_unicode(self):
+        self.assertEqual(encode({'action': 'encode', 'fields': {'k': 'a=b=é'}}),
+                         'k=a=b=é')
+
+    def test_encode_invalid_key(self):
+        with self.assertRaises(ValueError):
+            encode({'action': 'encode', 'fields': {'9bad': 'x'}})
+        with self.assertRaises(ValueError):
+            encode({'action': 'encode', 'fields': {'': 'x'}})
+        with self.assertRaises(ValueError):
+            encode({'action': 'encode', 'fields': {'a b': 'x'}})
+
+    def test_decode_empty_line(self):
+        self.assertEqual(decode({'action': 'decode', 'line': ''}), {})
+
+    def test_decode_basic(self):
+        self.assertEqual(decode({'action': 'decode', 'line': 'a=1\tb=2'}),
+                         {'a': '1', 'b': '2'})
+
+    def test_decode_first_equals_only(self):
+        self.assertEqual(decode({'action': 'decode', 'line': 'k=a=b'}), {'k': 'a=b'})
+
+    def test_decode_empty_value(self):
+        self.assertEqual(decode({'action': 'decode', 'line': 'k='}), {'k': ''})
+
+    def test_decode_unescapes(self):
+        self.assertEqual(decode({'action': 'decode', 'line': 'k=a\\\\b\\tc\\nd\\re'}),
+                         {'k': 'a\\b\tc\nd\re'})
+
+    def test_decode_unknown_escape(self):
+        with self.assertRaises(ValueError):
+            decode({'action': 'decode', 'line': 'k=\\q'})
+
+    def test_decode_trailing_escape(self):
+        with self.assertRaises(ValueError):
+            decode({'action': 'decode', 'line': 'k=x\\'})
+
+    def test_decode_trailing_tab(self):
+        with self.assertRaises(ValueError):
+            decode({'action': 'decode', 'line': 'k=1\t'})
+
+    def test_decode_no_equals(self):
+        with self.assertRaises(ValueError):
+            decode({'action': 'decode', 'line': 'k=1\tnope'})
+
+    def test_decode_duplicate_key(self):
+        with self.assertRaises(ValueError):
+            decode({'action': 'decode', 'line': 'k=1\tk=2'})
+
+    def test_decode_invalid_key(self):
+        with self.assertRaises(ValueError):
+            decode({'action': 'decode', 'line': '9k=1'})
+
+    def test_roundtrip(self):
+        fields = {'a': 'x\\y\tz\nw\rq=e', 'b_2': 'ünï✓'}
+        line = encode({'action': 'encode', 'fields': fields})
+        self.assertEqual(decode({'action': 'decode', 'line': line}), fields)
+
+    def test_dispatch_routing(self):
+        self.assertEqual(dispatch({'action': 'encode', 'fields': {'a': '1'}}), 'a=1')
+        self.assertEqual(dispatch({'action': 'decode', 'line': 'a=1'}), {'a': '1'})
+        self.assertEqual(dispatch({'action': 'field_names', 'fields': {'b': '', 'a': ''}}),
+                         ['a', 'b'])
+
+    def test_unknown_action(self):
+        with self.assertRaises(ValueError):
+            dispatch({'action': 'nope'})
+
+    def test_no_input_mutation(self):
+        payload = {'action': 'encode', 'fields': {'b': '2', 'a': '1'}}
+        encode(payload)
+        self.assertEqual(payload, {'action': 'encode', 'fields': {'b': '2', 'a': '1'}})
+        payload = {'action': 'decode', 'line': 'k=1\tk=2'}
+        with self.assertRaises(ValueError):
+            decode(payload)
+        self.assertEqual(payload, {'action': 'decode', 'line': 'k=1\tk=2'})
+
+    def test_cli_success(self):
+        proc = subprocess.run(['python', '-B', '-I', 'cli.py'],
+                              input=json.dumps({'action': 'encode', 'fields': {'a': 'x\ty'}}),
+                              capture_output=True, text=True)
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(json.loads(proc.stdout), 'a=x\\ty')
+        self.assertEqual(proc.stderr, '')
+
+    def test_cli_value_error(self):
+        proc = subprocess.run(['python', '-B', '-I', 'cli.py'],
+                              input=json.dumps({'action': 'decode', 'line': 'nope'}),
+                              capture_output=True, text=True)
+        self.assertEqual(proc.returncode, 2)
+        self.assertNotEqual(proc.stderr, '')
+        self.assertEqual(proc.stdout, '')
+        self.assertNotIn('Traceback', proc.stderr)
+
+
+if __name__ == '__main__':
+    unittest.main()
