+import copy
+import unittest
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+import domain
+from api import dispatch
+
+
+class IngestTests(unittest.TestCase):
+    def test_basic_release(self):
+        payload = {
+            "action": "ingest",
+            "watermarks": {"a": 1},
+            "events": [
+                {"source": "a", "seq": 2, "data": {"x": 1}},
+                {"source": "a", "seq": 4, "data": None},
+                {"source": "b", "seq": 1, "data": [1, 2]},
+            ],
+        }
+        result = dispatch(payload)
+        self.assertEqual(
+            result,
+            {
+                "watermarks": {"a": 2, "b": 1},
+                "released": [
+                    {"source": "a", "seq": 2, "data": {"x": 1}},
+                    {"source": "b", "seq": 1, "data": [1, 2]},
+                ],
+                "pending": [{"source": "a", "seq": 4, "data": None}],
+            },
+        )
+
+    def test_missing_source_starts_at_zero(self):
+        payload = {
+            "action": "ingest",
+            "watermarks": {},
+            "events": [{"source": "z", "seq": 1, "data": "hi"}],
+        }
+        self.assertEqual(
+            dispatch(payload),
+            {
+                "watermarks": {"z": 1},
+                "released": [{"source": "z", "seq": 1, "data": "hi"}],
+                "pending": [],
+            },
+        )
+
+    def test_gap_retains_later_events(self):
+        payload = {
+            "action": "ingest",
+            "watermarks": {},
+            "events": [
+                {"source": "a", "seq": 2, "data": 1},
+                {"source": "a", "seq": 3, "data": 2},
+            ],
+        }
+        self.assertEqual(
+            dispatch(payload),
+            {
+                "watermarks": {"a": 0},
+                "released": [],
+                "pending": [
+                    {"source": "a", "seq": 2, "data": 1},
+                    {"source": "a", "seq": 3, "data": 2},
+                ],
+            },
+        )
+
+    def test_duplicate_identical_data_accepted(self):
+        payload = {
+            "action": "ingest",
+            "watermarks": {},
+            "events": [
+                {"source": "a", "seq": 1, "data": {"x": 1, "y": [1, {"z": 2}]}},
+                {"source": "a", "seq": 1, "data": {"y": [1, {"z": 2}], "x": 1}},
+            ],
+        }
+        result = dispatch(payload)
+        self.assertEqual(
+            result,
+            {
+                "watermarks": {"a": 1},
+                "released": [{"source": "a", "seq": 1, "data": {"x": 1, "y": [1, {"z": 2}]}}],
+                "pending": [],
+            },
+        )
+
+    def test_numeric_json_equality_duplicate(self):
+        payload = {
+            "action": "ingest",
+            "watermarks": {},
+            "events": [
+                {"source": "a", "seq": 1, "data": 1},
+                {"source": "a", "seq": 1, "data": 1.0},
+            ],
+        }
+        result = dispatch(payload)
+        self.assertEqual(
+            result,
+            {
+                "watermarks": {"a": 1},
+                "released": [{"source": "a", "seq": 1, "data": 1}],
+                "pending": [],
+            },
+        )
+
+    def test_numeric_equality_nested(self):
+        payload = {
+            "action": "ingest",
+            "watermarks": {},
+            "events": [
+                {"source": "a", "seq": 1, "data": {"n": [1, {"m": 2}]}},
+                {"source": "a", "seq": 1, "data": {"n": [1.0, {"m": 2.0}]}},
+            ],
+        }
+        result = dispatch(payload)
+        self.assertEqual(
+            result,
+            {
+                "watermarks": {"a": 1},
+                "released": [{"source": "a", "seq": 1, "data": {"n": [1, {"m": 2}]}}],
+                "pending": [],
+            },
+        )
+
+    def test_conflicting_data_raises(self):
+        payload = {
+            "action": "ingest",
+            "watermarks": {},
+            "events": [
+                {"source": "a", "seq": 1, "data": {"x": 1}},
+                {"source": "a", "seq": 1, "data": {"x": 2}},
+            ],
+        }
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+
+    def test_conflicts_among_ignored_events_do_not_matter(self):
+        payload = {
+            "action": "ingest",
+            "watermarks": {"a": 5},
+            "events": [
+                {"source": "a", "seq": 3, "data": {"x": 1}},
+                {"source": "a", "seq": 3, "data": {"x": 2}},
+                {"source": "a", "seq": 5, "data": "old"},
+                {"source": "a", "seq": 5, "data": "other"},
+                {"source": "a", "seq": 6, "data": "new"},
+            ],
+        }
+        result = dispatch(payload)
+        self.assertEqual(
+            result,
+            {
+                "watermarks": {"a": 6},
+                "released": [{"source": "a", "seq": 6, "data": "new"}],
+                "pending": [],
+            },
+        )
+
+    def test_sorting_by_source_then_seq(self):
+        payload = {
+            "action": "ingest",
+            "watermarks": {},
+            "events": [
+                {"source": "b", "seq": 10, "data": None},
+                {"source": "b", "seq": 2, "data": None},
+                {"source": "a", "seq": 2, "data": None},
+                {"source": "a", "seq": 1, "data": None},
+                {"source": "a", "seq": 10, "data": None},
+            ],
+        }
+        result = dispatch(payload)
+        self.assertEqual(
+            [(e["source"], e["seq"]) for e in result["released"]],
+            [("a", 1), ("a", 2)],
+        )
+        self.assertEqual(
+            [(e["source"], e["seq"]) for e in result["pending"]],
+            [("a", 10), ("b", 2), ("b", 10)],
+        )
+        self.assertEqual(result["watermarks"], {"a": 2, "b": 0})
+
+    def test_input_not_mutated(self):
+        payload = {
+            "action": "ingest",
+            "watermarks": {"a": 1},
+            "events": [{"source": "a", "seq": 2, "data": {"k": [1]}}],
+        }
+        snapshot = copy.deepcopy(payload)
+        result = dispatch(payload)
+        self.assertEqual(payload, snapshot)
+        self.assertEqual(result["watermarks"], {"a": 2})
+        # Returned data must not alias the input either way is required, but
+        # input object must be untouched.
+        self.assertEqual(payload["events"][0]["data"], {"k": [1]})
+
+    def test_watermarks_retain_original_sources(self):
+        payload = {
+            "action": "ingest",
+            "watermarks": {"a": 3, "b": 0},
+            "events": [],
+        }
+        self.assertEqual(
+            dispatch(payload),
+            {"watermarks": {"a": 3, "b": 0}, "released": [], "pending": []},
+        )
+
+
+    def test_large_ints_are_distinct_not_duplicates(self):
+        payload = {
+            "action": "ingest",
+            "watermarks": {},
+            "events": [
+                {"source": "a", "seq": 1, "data": 10**20},
+                {"source": "a", "seq": 1, "data": 10**20 + 1},
+            ],
+        }
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+
+    def test_large_int_nested_conflict(self):
+        payload = {
+            "action": "ingest",
+            "watermarks": {},
+            "events": [
+                {"source": "a", "seq": 3, "data": {"n": [2**64]}},
+                {"source": "a", "seq": 3, "data": {"n": [2**64 + 1]}},
+            ],
+        }
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+
+    def test_bool_not_conflated_with_number(self):
+        payload = {
+            "action": "ingest",
+            "watermarks": {},
+            "events": [
+                {"source": "a", "seq": 1, "data": True},
+                {"source": "a", "seq": 1, "data": 1},
+            ],
+        }
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+
+    def test_huge_seq_no_gap_iteration_blowup(self):
+        payload = {
+            "action": "ingest",
+            "watermarks": {"a": 0},
+            "events": [{"source": "a", "seq": 10**9, "data": "far"}],
+        }
+        snapshot = copy.deepcopy(payload)
+        self.assertEqual(
+            dispatch(payload),
+            {
+                "watermarks": {"a": 0},
+                "released": [],
+                "pending": [{"source": "a", "seq": 10**9, "data": "far"}],
+            },
+        )
+        self.assertEqual(payload, snapshot)
+
+    def test_huge_seq_contiguous_run_released(self):
+        payload = {
+            "action": "ingest",
+            "watermarks": {"a": 10**12},
+            "events": [
+                {"source": "a", "seq": 10**12 + 2, "data": 2},
+                {"source": "a", "seq": 10**12 + 1, "data": 1},
+            ],
+        }
+        self.assertEqual(
+            dispatch(payload),
+            {
+                "watermarks": {"a": 10**12 + 2},
+                "released": [
+                    {"source": "a", "seq": 10**12 + 1, "data": 1},
+                    {"source": "a", "seq": 10**12 + 2, "data": 2},
+                ],
+                "pending": [],
+            },
+        )
+
+    def test_unknown_action_raises(self):
+        with self.assertRaises(ValueError):
+            dispatch({"action": "nope", "events": [], "watermarks": {}})
+
+    def test_existing_sources_action_preserved(self):
+        payload = {"action": "sources", "events": [
+            {"source": "b", "seq": 1, "data": None},
+            {"source": "a", "seq": 1, "data": None},
+        ]}
+        self.assertEqual(dispatch(payload), ["a", "b"])
+
+    def test_cli_success(self):
+        import subprocess
+        payload = {
+            "action": "ingest",
+            "watermarks": {"a": 1},
+            "events": [{"source": "a", "seq": 2, "data": {"x": 1}}],
+        }
+        proc = subprocess.run(
+            ["python", "cli.py"],
+            input=__import__("json").dumps(payload),
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(
+            __import__("json").loads(proc.stdout),
+            {"watermarks": {"a": 2},
+             "released": [{"source": "a", "seq": 2, "data": {"x": 1}}],
+             "pending": []},
+        )
+        self.assertEqual(proc.stderr, "")
+
+    def test_cli_valueerror_exit_2(self):
+        import subprocess
+        import json
+        payload = {
+            "action": "ingest",
+            "watermarks": {},
+            "events": [
+                {"source": "a", "seq": 1, "data": 1},
+                {"source": "a", "seq": 1, "data": 2},
+            ],
+        }
+        proc = subprocess.run(
+            ["python", "cli.py"],
+            input=json.dumps(payload),
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual(proc.returncode, 2)
+        self.assertNotEqual(proc.stderr, "")
+        self.assertEqual(proc.stdout, "")
+        self.assertNotIn("Traceback", proc.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
