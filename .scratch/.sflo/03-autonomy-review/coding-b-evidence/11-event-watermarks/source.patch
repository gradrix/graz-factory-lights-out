+from fractions import Fraction
+
+
 def sources(payload):
     return sorted({event['source'] for event in payload['events']})
+
+
+def _json_equal(left, right):
+    """Exact JSON value equality: object key order is irrelevant and JSON
+    numbers compare by numeric value (so 1 and 1.0 are the same JSON number)
+    with no lossy float conversion. Booleans are never conflated with
+    numbers."""
+    if isinstance(left, bool) or isinstance(right, bool):
+        return isinstance(left, bool) and isinstance(right, bool) and left == right
+    if isinstance(left, (int, float)) and isinstance(right, (int, float)):
+        # Fraction keeps float values exact, so 10**20 and 10**20 + 1 stay
+        # distinct even when one arrives in float form.
+        return Fraction(left) == Fraction(right)
+    if isinstance(left, list) and isinstance(right, list):
+        return len(left) == len(right) and all(
+            _json_equal(a, b) for a, b in zip(left, right)
+        )
+    if isinstance(left, dict) and isinstance(right, dict):
+        return left.keys() == right.keys() and all(
+            _json_equal(left[key], right[key]) for key in left
+        )
+    return type(left) is type(right) and left == right
+
+
+def _canonical_json(value):
+    """Normalize a decoded JSON value into a hashable canonical form.
+
+    Values that are JSON-equal canonicalize alike (object key order
+    normalized; 1 and 1.0 canonicalize alike). Distinct JSON numbers always
+    canonicalize differently: ints keep full precision, floats are rendered
+    exactly with repr.
+    """
+    if isinstance(value, bool):
+        return ('bool', value)
+    if isinstance(value, int):
+        return ('int', value)
+    if isinstance(value, float):
+        return ('float', repr(value))
+    if isinstance(value, list):
+        return ('list', tuple(_canonical_json(item) for item in value))
+    if isinstance(value, dict):
+        return ('dict', tuple(sorted(
+            (_canonical_json(key), _canonical_json(item))
+            for key, item in value.items()
+        )))
+    return ('other', value)
+
+
+def ingest(payload):
+    """Ingest events with per-source watermarks.
+
+    payload keys: watermarks (source -> nonnegative int), events
+    (list of {source: str, seq: positive int, data: JSON}).
+    Returns {watermarks, released, pending}; released/pending are sorted by
+    (source lexicographic, seq numeric), one object {source, seq, data} per
+    unique source/seq. The input payload is never mutated.
+    """
+    starting = dict(payload['watermarks'])
+    # Missing sources start at watermark 0; every input source is retained.
+    for event in payload['events']:
+        starting.setdefault(event['source'], 0)
+
+    # Group events by (source, seq): repeated identical data (JSON equality)
+    # is a duplicate; conflicting data at the same source/seq raises
+    # ValueError. Events at/below the starting watermark are ignored first,
+    # so conflicts among those old events do not matter.
+    grouped = {}  # (source, seq) -> [data, canonical_form]
+    for event in payload['events']:
+        source, seq = event['source'], event['seq']
+        if seq <= starting[source]:
+            continue  # ignored old event
+        key = (source, seq)
+        form = _canonical_json(event['data'])
+        existing = grouped.get(key)
+        if existing is None:
+            grouped[key] = [event['data'], form]
+        elif not _json_equal(existing[0], event['data']):
+            raise ValueError(
+                "conflicting data for source %r at seq %d" % (source, seq)
+            )
+
+    # Release only the contiguous run beginning at starting watermark + 1
+    # per source; events past the first gap stay pending. Sequence numbers
+    # are walked in sorted order, so huge seq values cost no extra work.
+    seqs_by_source = {}
+    for source, seq in grouped:
+        seqs_by_source.setdefault(source, []).append(seq)
+    watermarks = dict(starting)
+    released = []
+    pending = []
+    for source, seqs in seqs_by_source.items():
+        seqs.sort()
+        expected = starting[source] + 1
+        for i, seq in enumerate(seqs):
+            if seq == expected:
+                data, _form = grouped[(source, seq)]
+                released.append({"source": source, "seq": seq, "data": data})
+                watermarks[source] = seq
+                expected += 1
+            else:
+                for pending_seq in seqs[i:]:
+                    data, _form = grouped[(source, pending_seq)]
+                    pending.append(
+                        {"source": source, "seq": pending_seq, "data": data}
+                    )
+                break
+    released.sort(key=lambda item: (item['source'], item['seq']))
+    pending.sort(key=lambda item: (item['source'], item['seq']))
+    return {"watermarks": watermarks, "released": released, "pending": pending}
