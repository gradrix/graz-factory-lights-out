+import unittest
+import json
+import subprocess
+import sys
+
+sys.path.insert(0, '/workspace')
+
+from api import dispatch
+from domain import schedule, attempts
+
+
+class ScheduleTests(unittest.TestCase):
+    def test_transient_retry_within_cap(self):
+        payload = {'action': 'schedule', 'now': 100, 'attempt': 1, 'base': 10,
+                   'cap': 3600, 'max_attempts': 5, 'outcome': 'transient'}
+        result = dispatch(payload)
+        self.assertEqual(result, {'retry': True, 'at': 110, 'delay': 10})
+
+    def test_transient_exponential_backoff(self):
+        payload = {'action': 'schedule', 'now': 0, 'attempt': 4, 'base': 3,
+                   'cap': 1000, 'max_attempts': 10, 'outcome': 'transient'}
+        result = dispatch(payload)
+        self.assertEqual(result, {'retry': True, 'at': 24, 'delay': 24})
+
+    def test_transient_capped(self):
+        payload = {'action': 'schedule', 'now': 50, 'attempt': 8, 'base': 10,
+                   'cap': 60, 'max_attempts': 20, 'outcome': 'transient'}
+        result = dispatch(payload)
+        self.assertEqual(result, {'retry': True, 'at': 110, 'delay': 60})
+
+    def test_retry_after_below_backoff(self):
+        payload = {'action': 'schedule', 'now': 0, 'attempt': 3, 'base': 10,
+                   'cap': 1000, 'max_attempts': 5, 'outcome': 'transient',
+                   'retry_after': 5}
+        self.assertEqual(dispatch(payload), {'retry': True, 'at': 40, 'delay': 40})
+
+    def test_retry_after_above_backoff(self):
+        payload = {'action': 'schedule', 'now': 0, 'attempt': 1, 'base': 10,
+                   'cap': 100, 'max_attempts': 5, 'outcome': 'transient',
+                   'retry_after': 30}
+        self.assertEqual(dispatch(payload), {'retry': True, 'at': 30, 'delay': 30})
+
+    def test_retry_after_exceeds_cap(self):
+        payload = {'action': 'schedule', 'now': 7, 'attempt': 1, 'base': 10,
+                   'cap': 100, 'max_attempts': 5, 'outcome': 'transient',
+                   'retry_after': 500}
+        self.assertEqual(dispatch(payload), {'retry': True, 'at': 507, 'delay': 500})
+
+    def test_retry_after_zero(self):
+        payload = {'action': 'schedule', 'now': 0, 'attempt': 1, 'base': 5,
+                   'cap': 50, 'max_attempts': 2, 'outcome': 'transient',
+                   'retry_after': 0}
+        self.assertEqual(dispatch(payload), {'retry': True, 'at': 5, 'delay': 5})
+
+    def test_retry_after_null(self):
+        payload = {'action': 'schedule', 'now': 0, 'attempt': 1, 'base': 5,
+                   'cap': 50, 'max_attempts': 2, 'outcome': 'transient',
+                   'retry_after': None}
+        self.assertEqual(dispatch(payload), {'retry': True, 'at': 5, 'delay': 5})
+
+    def test_transient_last_attempt_no_retry(self):
+        payload = {'action': 'schedule', 'now': 10, 'attempt': 3, 'base': 10,
+                   'cap': 100, 'max_attempts': 3, 'outcome': 'transient'}
+        self.assertEqual(dispatch(payload), {'retry': False, 'at': None, 'delay': None})
+
+    def test_success_no_retry(self):
+        payload = {'action': 'schedule', 'now': 10, 'attempt': 1, 'base': 10,
+                   'cap': 100, 'max_attempts': 3, 'outcome': 'success'}
+        self.assertEqual(dispatch(payload), {'retry': False, 'at': None, 'delay': None})
+
+    def test_permanent_no_retry(self):
+        payload = {'action': 'schedule', 'now': 10, 'attempt': 1, 'base': 10,
+                   'cap': 100, 'max_attempts': 3, 'outcome': 'permanent'}
+        self.assertEqual(dispatch(payload), {'retry': False, 'at': None, 'delay': None})
+
+    def test_invalid_outcome_even_without_retry(self):
+        payload = {'action': 'schedule', 'now': 10, 'attempt': 1, 'base': 10,
+                   'cap': 100, 'max_attempts': 1, 'outcome': 'bogus'}
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+
+    def test_invalid_attempt(self):
+        payload = {'action': 'schedule', 'now': 0, 'attempt': 0, 'base': 1,
+                   'cap': 1, 'max_attempts': 1, 'outcome': 'success'}
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+
+    def test_invalid_base(self):
+        payload = {'action': 'schedule', 'now': 0, 'attempt': 1, 'base': 0,
+                   'cap': 1, 'max_attempts': 1, 'outcome': 'success'}
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+
+    def test_invalid_cap(self):
+        payload = {'action': 'schedule', 'now': 0, 'attempt': 1, 'base': 1,
+                   'cap': -5, 'max_attempts': 1, 'outcome': 'success'}
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+
+    def test_invalid_max_attempts(self):
+        payload = {'action': 'schedule', 'now': 0, 'attempt': 1, 'base': 1,
+                   'cap': 1, 'max_attempts': 0, 'outcome': 'success'}
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+
+    def test_invalid_retry_after(self):
+        payload = {'action': 'schedule', 'now': 0, 'attempt': 1, 'base': 1,
+                   'cap': 1, 'max_attempts': 1, 'outcome': 'success',
+                   'retry_after': -1}
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+
+    def test_invalid_now(self):
+        payload = {'action': 'schedule', 'now': 'x', 'attempt': 1, 'base': 1,
+                   'cap': 1, 'max_attempts': 1, 'outcome': 'success'}
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+
+    def test_unknown_action(self):
+        payload = {'action': 'nope', 'now': 0}
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+
+    def test_existing_attempts_action(self):
+        payload = {'action': 'attempts', 'outcomes': ['success', 'transient']}
+        self.assertEqual(dispatch(payload), 2)
+
+    def test_input_not_mutated(self):
+        payload = {'action': 'schedule', 'now': 1, 'attempt': 2, 'base': 4,
+                   'cap': 9, 'max_attempts': 4, 'outcome': 'transient'}
+        before = json.dumps(payload, sort_keys=True)
+        dispatch(payload)
+        self.assertEqual(json.dumps(payload, sort_keys=True), before)
+
+    def test_rejected_input_not_mutated(self):
+        payload = {'action': 'schedule', 'now': 1, 'attempt': 0, 'base': 4,
+                   'cap': 9, 'max_attempts': 4, 'outcome': 'transient'}
+        before = json.dumps(payload, sort_keys=True)
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+        self.assertEqual(json.dumps(payload, sort_keys=True), before)
+
+    def test_large_exponent_exact_arithmetic(self):
+        payload = {'action': 'schedule', 'now': 0, 'attempt': 64, 'base': 3,
+                   'cap': 10**6, 'max_attempts': 100, 'outcome': 'transient'}
+        result = dispatch(payload)
+        self.assertEqual(result, {'retry': True, 'at': 10**6, 'delay': 10**6})
+
+
+class CliTests(unittest.TestCase):
+    def run_cli(self, stdin_text):
+        proc = subprocess.run(
+            [sys.executable, 'cli.py'],
+            input=stdin_text, capture_output=True, text=True, cwd='/workspace')
+        return proc
+
+    def test_cli_success(self):
+        payload = {'action': 'schedule', 'now': 100, 'attempt': 2, 'base': 10,
+                   'cap': 3600, 'max_attempts': 5, 'outcome': 'transient'}
+        proc = self.run_cli(json.dumps(payload))
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(proc.stderr, '')
+        self.assertEqual(json.loads(proc.stdout),
+                         {'retry': True, 'at': 120, 'delay': 20})
+
+    def test_cli_attempts_success(self):
+        proc = self.run_cli(json.dumps({'action': 'attempts',
+                                        'outcomes': ['a', 'b', 'c']}))
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(json.loads(proc.stdout), 3)
+
+    def test_cli_value_error_exit_2(self):
+        proc = self.run_cli(json.dumps({'action': 'nope'}))
+        self.assertEqual(proc.returncode, 2)
+        self.assertNotEqual(proc.stderr, '')
+        self.assertNotIn('Traceback', proc.stderr)
+        self.assertEqual(proc.stdout, '')
+
+    def test_cli_invalid_schedule_exit_2(self):
+        proc = self.run_cli(json.dumps({'action': 'schedule', 'now': 0,
+                                        'attempt': 1, 'base': 1, 'cap': 1,
+                                        'max_attempts': 1, 'outcome': 'bad'}))
+        self.assertEqual(proc.returncode, 2)
+        self.assertNotEqual(proc.stderr, '')
+        self.assertNotIn('Traceback', proc.stderr)
+
+
+if __name__ == '__main__':
+    unittest.main()
