@@ -1,2 +1,36 @@
 def attempts(payload):
     return len(payload['outcomes'])
+
+
+def schedule(payload):
+    now = payload['now']
+    attempt = payload['attempt']
+    base = payload['base']
+    cap = payload['cap']
+    max_attempts = payload['max_attempts']
+    outcome = payload['outcome']
+    retry_after = payload.get('retry_after')
+
+    def is_int(value):
+        return isinstance(value, int) and not isinstance(value, bool)
+
+    if not is_int(now):
+        raise ValueError('now must be an integer')
+    if not is_int(attempt) or attempt < 1:
+        raise ValueError('attempt must be an integer >= 1')
+    if not is_int(base) or base < 1:
+        raise ValueError('base must be a positive integer')
+    if not is_int(cap) or cap < 1:
+        raise ValueError('cap must be a positive integer')
+    if not is_int(max_attempts) or max_attempts < 1:
+        raise ValueError('max_attempts must be an integer >= 1')
+    if outcome not in ('success', 'permanent', 'transient'):
+        raise ValueError("outcome must be 'success', 'permanent', or 'transient'")
+    if retry_after is not None:
+        if not is_int(retry_after) or retry_after < 0:
+            raise ValueError('retry_after must be null or a nonnegative integer')
+
+    if outcome == 'transient' and attempt < max_attempts:
+        delay = max(min(cap, base * 2 ** (attempt - 1)), retry_after or 0)
+        return {'retry': True, 'at': now + delay, 'delay': delay}
+    return {'retry': False, 'at': None, 'delay': None}
