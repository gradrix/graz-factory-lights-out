+from collections import OrderedDict
+
+
 def weight(payload):
     return sum(entry['weight'] for entry in payload['entries'])
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def cache(payload):
+    capacity = payload['capacity']
+    if not _is_int(capacity) or capacity < 0:
+        raise ValueError("capacity must be a nonnegative integer")
+    operations = payload['operations']
+    if not isinstance(operations, list):
+        raise ValueError("operations must be a list")
+    entries = OrderedDict()
+    results = []
+    for operation in operations:
+        if not isinstance(operation, dict):
+            raise ValueError("operation must be an object")
+        op = operation['op']
+        if op == 'get':
+            key = operation['key']
+            if key in entries:
+                entries.move_to_end(key)
+                results.append({'hit': True, 'value': entries[key]['value']})
+            else:
+                results.append({'hit': False, 'value': None})
+        elif op == 'put':
+            key = operation['key']
+            value = operation['value']
+            item_weight = operation['weight']
+            if not _is_int(item_weight) or item_weight <= 0:
+                raise ValueError("weight must be a positive integer")
+            if item_weight > capacity:
+                results.append({'stored': False, 'evicted': []})
+                continue
+            if key in entries:
+                del entries[key]
+            entries[key] = {'key': key, 'value': value, 'weight': item_weight}
+            entries.move_to_end(key)
+            evicted = []
+            while sum(entry['weight'] for entry in entries.values()) > capacity:
+                oldest_key, _ = next(iter(entries.items()))
+                del entries[oldest_key]
+                evicted.append(oldest_key)
+            results.append({'stored': True, 'evicted': evicted})
+        else:
+            raise ValueError("unknown operation: " + str(op))
+    result_entries = [
+        {'key': entry['key'], 'value': entry['value'], 'weight': entry['weight']}
+        for entry in entries.values()
+    ]
+    return {'results': results, 'entries': result_entries}
