@@ -0,0 +1,130 @@
+import json
+import unittest
+from api import dispatch
+
+
+def put(key, value, weight):
+    return {'op': 'put', 'key': key, 'value': value, 'weight': weight}
+
+
+def get(key):
+    return {'op': 'get', 'key': key}
+
+
+class CacheTests(unittest.TestCase):
+    def test_acceptance_example(self):
+        payload = {'action': 'cache', 'capacity': 5,
+                   'operations': [put('a', 2, 1), put('b', 2, 2), get('a'),
+                                  put('c', 3, 3), get('b')]}
+        result = dispatch(payload)
+        self.assertEqual(result['results'], [
+            {'stored': True, 'evicted': []},
+            {'stored': True, 'evicted': []},
+            {'hit': True, 'value': 2},
+            {'stored': True, 'evicted': ['b']},
+            {'hit': False, 'value': None},
+        ])
+        self.assertEqual(result['entries'], [
+            {'key': 'a', 'value': 2, 'weight': 1},
+            {'key': 'c', 'value': 3, 'weight': 3},
+        ])
+
+    def test_empty_operations(self):
+        result = dispatch({'action': 'cache', 'capacity': 3, 'operations': []})
+        self.assertEqual(result, {'results': [], 'entries': []})
+
+    def test_capacity_zero(self):
+        result = dispatch({'action': 'cache', 'capacity': 0,
+                           'operations': [put('a', 1, 1)]})
+        self.assertEqual(result, {'results': [{'stored': False, 'evicted': []}],
+                                  'entries': []})
+
+    def test_invalid_capacity_raises(self):
+        for capacity in [-1, 2.5, '3', True, None]:
+            with self.assertRaises(ValueError):
+                dispatch({'action': 'cache', 'capacity': capacity,
+                          'operations': []})
+
+    def test_invalid_weight_raises(self):
+        for weight in [0, -2, 1.5, '2', True]:
+            with self.assertRaises(ValueError):
+                dispatch({'action': 'cache', 'capacity': 5,
+                          'operations': [put('a', 1, weight)]})
+
+    def test_too_heavy_put_leaves_cache_untouched(self):
+        operations = [put('a', 1, 2), put('a', 9, 9)]
+        result = dispatch({'action': 'cache', 'capacity': 5,
+                           'operations': operations})
+        self.assertEqual(result['results'], [
+            {'stored': True, 'evicted': []},
+            {'stored': False, 'evicted': []},
+        ])
+        self.assertEqual(result['entries'], [{'key': 'a', 'value': 1, 'weight': 2}])
+
+    def test_replacement_evicts_only_others(self):
+        operations = [put('a', 1, 2), put('b', 2, 2), put('a', 9, 2)]
+        result = dispatch({'action': 'cache', 'capacity': 4,
+                           'operations': operations})
+        self.assertEqual(result['results'], [
+            {'stored': True, 'evicted': []},
+            {'stored': True, 'evicted': []},
+            {'stored': True, 'evicted': []},
+        ])
+        self.assertEqual(result['entries'], [
+            {'key': 'b', 'value': 2, 'weight': 2},
+            {'key': 'a', 'value': 9, 'weight': 2},
+        ])
+
+    def test_get_promotes_and_miss_keeps_order(self):
+        operations = [put('a', 1, 1), put('b', 2, 1), put('c', 3, 1),
+                      get('a'), get('zz'), put('d', 4, 1)]
+        result = dispatch({'action': 'cache', 'capacity': 3,
+                           'operations': operations})
+        self.assertEqual(result['results'][3], {'hit': True, 'value': 1})
+        self.assertEqual(result['results'][4], {'hit': False, 'value': None})
+        self.assertEqual(result['results'][5], {'stored': True, 'evicted': ['b']})
+        self.assertEqual([(e['key']) for e in result['entries']], ['c', 'a', 'd'])
+
+    def test_multi_eviction_order(self):
+        operations = [put('a', 1, 1), put('b', 2, 1), put('c', 3, 1),
+                      put('d', 4, 3)]
+        result = dispatch({'action': 'cache', 'capacity': 4,
+                           'operations': operations})
+        self.assertEqual(result['results'][3], {'stored': True, 'evicted': ['a', 'b']})
+        self.assertEqual(result['entries'], [
+            {'key': 'c', 'value': 3, 'weight': 1},
+            {'key': 'd', 'value': 4, 'weight': 3},
+        ])
+
+    def test_json_values_preserved(self):
+        value = {'x': [1, {'y': None}], 'z': 'ü'}
+        result = dispatch({'action': 'cache', 'capacity': 5,
+                           'operations': [put('a', value, 1), get('a')]})
+        self.assertEqual(result['results'][1], {'hit': True, 'value': value})
+        self.assertEqual(result['entries'][0]['value'], value)
+
+    def test_input_not_mutated(self):
+        operations = [put('a', 1, 2), get('a'), {'op': 'put', 'key': 'b',
+                                                 'value': 2, 'weight': 9}]
+        payload = {'action': 'cache', 'capacity': 3, 'operations': operations}
+        snapshot = json.dumps(payload, sort_keys=True)
+        dispatch(payload)
+        self.assertEqual(json.dumps(payload, sort_keys=True), snapshot)
+        self.assertEqual(operations, json.loads(json.dumps(operations)))
+
+    def test_unknown_operation_raises(self):
+        with self.assertRaises(ValueError):
+            dispatch({'action': 'cache', 'capacity': 1,
+                      'operations': [{'op': 'zap', 'key': 'a'}]})
+
+    def test_unknown_action_still_raises(self):
+        with self.assertRaises(ValueError):
+            dispatch({'action': 'nope'})
+
+    def test_weight_action_preserved(self):
+        self.assertEqual(dispatch({'action': 'weight',
+                                   'entries': [{'weight': 1}, {'weight': 4}]}), 5)
+
+
+if __name__ == '__main__':
+    unittest.main()
