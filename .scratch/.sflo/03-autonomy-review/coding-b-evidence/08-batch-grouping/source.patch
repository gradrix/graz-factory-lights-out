@@ -0,0 +1,159 @@
+import json
+import subprocess
+import sys
+import unittest
+
+sys.path.insert(0, '/workspace')
+from api import dispatch
+import domain
+
+
+class GroupOrdering(unittest.TestCase):
+    def test_requested_order_independent_of_response_order(self):
+        payload = {'action': 'group',
+                   'requested': ['c', 'a', 'b'],
+                   'responses': [{'id': 'b', 'ok': True, 'value': 2},
+                                 {'id': 'c', 'ok': False, 'error': 'boom'},
+                                 {'id': 'a', 'ok': True, 'value': 1}]}
+        result = dispatch(payload)
+        self.assertEqual(result, {
+            'successes': [{'id': 'a', 'value': 1}, {'id': 'b', 'value': 2}],
+            'failures': [{'id': 'c', 'error': 'boom'}],
+            'missing': []})
+
+    def test_missing_ids_only_in_missing(self):
+        payload = {'action': 'group',
+                   'requested': ['x', 'y', 'z'],
+                   'responses': [{'id': 'y', 'ok': True, 'value': 'hi'}]}
+        self.assertEqual(dispatch(payload), {
+            'successes': [{'id': 'y', 'value': 'hi'}],
+            'failures': [],
+            'missing': ['x', 'z']})
+
+    def test_empty_requested(self):
+        self.assertEqual(dispatch({'action': 'group', 'requested': [], 'responses': []}),
+                         {'successes': [], 'failures': [], 'missing': []})
+
+    def test_falsey_values_stay_in_successes(self):
+        payload = {'action': 'group',
+                   'requested': ['n', 'f', 'z', 'e', 'obj', 'arr'],
+                   'responses': [{'id': 'e', 'ok': True, 'value': ''},
+                                 {'id': 'z', 'ok': True, 'value': 0},
+                                 {'id': 'f', 'ok': True, 'value': False},
+                                 {'id': 'n', 'ok': True, 'value': None},
+                                 {'id': 'obj', 'ok': True, 'value': {'k': [1, {'d': None}]}},
+                                 {'id': 'arr', 'ok': True, 'value': []}]}
+        result = dispatch(payload)
+        self.assertEqual(result['successes'], [
+            {'id': 'n', 'value': None},
+            {'id': 'f', 'value': False},
+            {'id': 'z', 'value': 0},
+            {'id': 'e', 'value': ''},
+            {'id': 'obj', 'value': {'k': [1, {'d': None}]}},
+            {'id': 'arr', 'value': []}])
+        self.assertEqual(result['failures'], [])
+        self.assertEqual(result['missing'], [])
+
+    def test_failure_error_strings(self):
+        payload = {'action': 'group', 'requested': ['a', 'b'],
+                   'responses': [{'id': 'a', 'ok': False, 'error': 'nope'},
+                                 {'id': 'b', 'ok': False, 'error': ''}]}
+        self.assertEqual(dispatch(payload), {
+            'successes': [],
+            'failures': [{'id': 'a', 'error': 'nope'}, {'id': 'b', 'error': ''}],
+            'missing': []})
+
+
+class GroupRejections(unittest.TestCase):
+    def test_duplicate_requested_ids(self):
+        payload = {'action': 'group', 'requested': ['a', 'b', 'a'], 'responses': []}
+        with self.assertRaises(ValueError) as cm:
+            dispatch(payload)
+        self.assertIn('duplicate requested id', str(cm.exception))
+
+    def test_unknown_response_id(self):
+        payload = {'action': 'group', 'requested': ['a'],
+                   'responses': [{'id': 'a', 'ok': True, 'value': 1},
+                                 {'id': 'ghost', 'ok': True, 'value': 1}]}
+        with self.assertRaises(ValueError) as cm:
+            dispatch(payload)
+        self.assertIn('unknown response id', str(cm.exception))
+
+    def test_duplicate_responses(self):
+        payload = {'action': 'group', 'requested': ['a'],
+                   'responses': [{'id': 'a', 'ok': True, 'value': 1},
+                                 {'id': 'a', 'ok': False, 'error': 'again'}]}
+        with self.assertRaises(ValueError) as cm:
+            dispatch(payload)
+        self.assertIn('duplicate response id', str(cm.exception))
+
+    def test_unknown_action_still_rejected(self):
+        with self.assertRaises(ValueError) as cm:
+            dispatch({'action': 'nope', 'requested': [], 'responses': []})
+        self.assertEqual(str(cm.exception), 'unknown action: nope')
+
+
+class NoMutation(unittest.TestCase):
+    def test_input_payload_not_mutated_even_when_rejected(self):
+        payload = {'action': 'group', 'requested': ['b', 'a'],
+                   'responses': [{'id': 'a', 'ok': True, 'value': {'deep': [1, 2]}},
+                                 {'id': 'b', 'ok': False, 'error': 'e'}]}
+        snapshot = json.dumps(payload, sort_keys=True)
+        dispatch(payload)
+        self.assertEqual(json.dumps(payload, sort_keys=True), snapshot)
+
+    def test_rejected_payload_not_mutated(self):
+        payload = {'action': 'group', 'requested': ['a', 'a'],
+                   'responses': [{'id': 'a', 'ok': True, 'value': [1]}]}
+        snapshot = json.dumps(payload, sort_keys=True)
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+        self.assertEqual(json.dumps(payload, sort_keys=True), snapshot)
+
+    def test_existing_ids_action_unchanged(self):
+        payload = {'action': 'ids', 'items': [{'id': 'q'}, {'id': 'r'}]}
+        snapshot = json.dumps(payload, sort_keys=True)
+        self.assertEqual(dispatch(payload), ['q', 'r'])
+        self.assertEqual(json.dumps(payload, sort_keys=True), snapshot)
+
+
+class CliBehaviour(unittest.TestCase):
+    def run_cli(self, stdin_text):
+        proc = subprocess.run([sys.executable, '/workspace/cli.py'],
+                              input=stdin_text, capture_output=True, text=True)
+        return proc
+
+    def test_cli_success(self):
+        payload = {'action': 'group', 'requested': ['b', 'a'],
+                   'responses': [{'id': 'a', 'ok': True, 'value': None},
+                                 {'id': 'b', 'ok': False, 'error': 'x'}]}
+        proc = self.run_cli(json.dumps(payload))
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(proc.stderr, '')
+        self.assertEqual(json.loads(proc.stdout), {
+            'successes': [{'id': 'a', 'value': None}],
+            'failures': [{'id': 'b', 'error': 'x'}],
+            'missing': []})
+
+    def test_cli_value_error_exit_2(self):
+        proc = self.run_cli(json.dumps({'action': 'group', 'requested': ['a', 'a'],
+                                        'responses': []}))
+        self.assertEqual(proc.returncode, 2)
+        self.assertNotEqual(proc.stderr, '')
+        self.assertEqual(proc.stdout, '')
+        self.assertNotIn('Traceback', proc.stderr)
+
+    def test_cli_unknown_action_exit_2(self):
+        proc = self.run_cli(json.dumps({'action': 'other'}))
+        self.assertEqual(proc.returncode, 2)
+        self.assertNotEqual(proc.stderr, '')
+        self.assertNotIn('Traceback', proc.stderr)
+
+    def test_cli_existing_ids_action(self):
+        proc = self.run_cli(json.dumps({'action': 'ids', 'items': [{'id': 'z'}]}))
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(json.loads(proc.stdout), ['z'])
+
+
+if __name__ == '__main__':
+    unittest.main()
