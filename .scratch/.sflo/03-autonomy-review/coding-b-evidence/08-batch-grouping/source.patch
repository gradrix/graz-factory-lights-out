 def ids(payload):
     return [item['id'] for item in payload['items']]
+
+
+def group(payload):
+    """Reconcile requested action ids with their responses.
+
+    payload: {'action': 'group', 'requested': [unique id strings in order],
+              'responses': [{'id': str, 'ok': True, 'value': JSON}
+                            | {'id': str, 'ok': False, 'error': str}]}
+    Returns {'successes': [{'id': id, 'value': value}],
+             'failures': [{'id': id, 'error': error}],
+             'missing': [id, ...]}
+    Every array follows the requested order; missing ids appear only in
+    'missing'. Raises ValueError for duplicate requested ids, response ids
+    that were not requested, or duplicate responses.
+    """
+    requested = payload['requested']
+    responses = payload['responses']
+
+    seen = set()
+    for rid in requested:
+        if rid in seen:
+            raise ValueError('duplicate requested id: ' + str(rid))
+        seen.add(rid)
+
+    by_id = {}
+    for response in responses:
+        rid = response['id']
+        if rid not in seen:
+            raise ValueError('unknown response id: ' + str(rid))
+        if rid in by_id:
+            raise ValueError('duplicate response id: ' + str(rid))
+        by_id[rid] = response
+
+    successes = []
+    failures = []
+    missing = []
+    for rid in requested:
+        response = by_id.get(rid)
+        if response is None:
+            missing.append(rid)
+        elif response['ok'] is True:
+            successes.append({'id': rid, 'value': response['value']})
+        else:
+            failures.append({'id': rid, 'error': response['error']})
+    return {'successes': successes, 'failures': failures, 'missing': missing}
