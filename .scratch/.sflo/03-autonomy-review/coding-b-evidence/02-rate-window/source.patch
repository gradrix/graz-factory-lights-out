@@ -1,2 +1,38 @@
 def count(payload):
     return len(payload['events'])
+
+
+def admit(payload):
+    history = payload['history']
+    now = payload['now']
+    window = payload['window']
+    limit = payload['limit']
+    if window <= 0:
+        raise ValueError("window must be a positive integer")
+    if limit < 0:
+        raise ValueError("limit must be a nonnegative integer")
+    for index, timestamp in enumerate(history):
+        if index and timestamp < history[index - 1]:
+            raise ValueError("history must be nondecreasing")
+    if history and history[-1] > now:
+        raise ValueError("history timestamps must not exceed now")
+    active = [timestamp for timestamp in history if timestamp > now - window]
+    retry_at = None
+    allowed = False
+    if len(active) < limit:
+        allowed = True
+        active.append(now)
+    elif limit > 0:
+        retry_at = _retry_at(active, limit, window)
+    return {"allowed": allowed, "history": active, "retry_at": retry_at}
+
+
+def _retry_at(active, limit, window):
+    # Earliest timestamp t >= now at which the active count drops strictly below
+    # limit, i.e. enough of the oldest entries have expired. active is
+    # nondecreasing and its count is >= limit here.
+    n = len(active)
+    drop = n - limit + 1
+    if drop > n:
+        drop = n
+    return active[drop - 1] + window
