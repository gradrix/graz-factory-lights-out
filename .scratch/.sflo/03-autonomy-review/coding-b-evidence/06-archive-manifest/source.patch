+import json
+
 def sizes(payload):
     return sum(entry['size'] for entry in payload['entries'])
+
+def _normalize_path(path):
+    """Normalize a POSIX-style manifest path.
+
+    Returns the normalized path (segments joined with '/'), or None when the
+    path is invalid: empty, leading '/', backslash, NUL, an '..' segment, or
+    a colon anywhere. '.' and empty segments are ignored while normalizing;
+    at least one real segment must remain.
+    """
+    if not path or path[0] == '/' or '\\' in path or '\x00' in path or ':' in path:
+        return None
+    segments = [segment for segment in path.split('/') if segment and segment != '.']
+    if not segments or any(segment == '..' for segment in segments):
+        return None
+    return '/'.join(segments)
+
+def validate(payload):
+    entries = payload['entries']
+    max_total = payload['max_total']
+    if max_total < 0:
+        raise ValueError("max_total must be nonnegative")
+    normalized_sizes = {}
+    total = 0
+    for entry in entries:
+        path = entry['path']
+        size = entry['size']
+        if size < 0:
+            raise ValueError("size must be nonnegative")
+        normalized = _normalize_path(path)
+        if normalized is None:
+            raise ValueError("invalid path: " + repr(path))
+        if normalized in normalized_sizes:
+            raise ValueError("duplicate path: " + normalized)
+        normalized_sizes[normalized] = size
+        total += size
+    for normalized in normalized_sizes:
+        prefix = normalized + '/'
+        for other in normalized_sizes:
+            if other != normalized and other.startswith(prefix):
+                raise ValueError("file/directory conflict: " + normalized + " is an ancestor of " + other)
+    if total > max_total:
+        raise ValueError("total size " + str(total) + " exceeds max_total " + str(max_total))
+    files = [{'path': path, 'size': normalized_sizes[path]} for path in sorted(normalized_sizes)]
+    return {'files': files, 'total': total}
