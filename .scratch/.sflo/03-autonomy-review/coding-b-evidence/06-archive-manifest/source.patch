+import json
+import os
+import unittest
+
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import api
+
+
+def dispatch(payload):
+    return api.dispatch(payload)
+
+
+class ValidateTests(unittest.TestCase):
+
+    def test_success_sorted_and_normalized(self):
+        payload = {'action': 'validate',
+                   'entries': [{'path': 'c', 'size': 2},
+                               {'path': 'a//./b/', 'size': 1},
+                               {'path': 'a/b2', 'size': 3}],
+                   'max_total': 6}
+        result = dispatch(payload)
+        self.assertEqual(result, {'files': [{'path': 'a/b', 'size': 1},
+                                            {'path': 'a/b2', 'size': 3},
+                                            {'path': 'c', 'size': 2}],
+                                  'total': 6})
+
+    def test_equality_allowed(self):
+        payload = {'action': 'validate',
+                   'entries': [{'path': 'a/b', 'size': 1}],
+                   'max_total': 1}
+        self.assertEqual(dispatch(payload), {'files': [{'path': 'a/b', 'size': 1}], 'total': 1})
+
+    def test_total_exceeds_max_total(self):
+        with self.assertRaises(ValueError):
+            dispatch({'action': 'validate',
+                      'entries': [{'path': 'a/b', 'size': 1}],
+                      'max_total': 0})
+
+    def test_negative_size(self):
+        with self.assertRaises(ValueError):
+            dispatch({'action': 'validate',
+                      'entries': [{'path': 'a', 'size': -1}],
+                      'max_total': 0})
+
+    def test_negative_max_total(self):
+        with self.assertRaises(ValueError):
+            dispatch({'action': 'validate', 'entries': [], 'max_total': -1})
+
+    def test_empty_entries(self):
+        self.assertEqual(dispatch({'action': 'validate', 'entries': [], 'max_total': 0}),
+                         {'files': [], 'total': 0})
+
+    def test_invalid_paths(self):
+        for path in ['', '/', '/a', 'a\\b', 'a:b', 'a\x00b', '..', 'a/../b',
+                     './', '//', 'a/..', 'x/..y/..']:
+            with self.assertRaises(ValueError):
+                dispatch({'action': 'validate',
+                          'entries': [{'path': path, 'size': 1}],
+                          'max_total': 1})
+
+    def test_dot_segments_ignored(self):
+        self.assertEqual(dispatch({'action': 'validate',
+                                    'entries': [{'path': './a/./b/', 'size': 1}],
+                                    'max_total': 1}),
+                         {'files': [{'path': 'a/b', 'size': 1}], 'total': 1})
+
+    def test_duplicate_normalized_paths(self):
+        with self.assertRaises(ValueError):
+            dispatch({'action': 'validate',
+                      'entries': [{'path': 'a/b', 'size': 1},
+                                  {'path': './a//b', 'size': 2}],
+                      'max_total': 3})
+
+    def test_ancestor_conflict(self):
+        with self.assertRaises(ValueError):
+            dispatch({'action': 'validate',
+                      'entries': [{'path': 'a/b', 'size': 1},
+                                  {'path': 'a', 'size': 2}],
+                      'max_total': 3})
+
+    def test_ancestor_conflict_either_order(self):
+        with self.assertRaises(ValueError):
+            dispatch({'action': 'validate',
+                      'entries': [{'path': 'a', 'size': 1},
+                                  {'path': 'a/b', 'size': 2}],
+                      'max_total': 3})
+
+    def test_prefix_but_not_whole_segment_ok(self):
+        result = dispatch({'action': 'validate',
+                           'entries': [{'path': 'a', 'size': 1},
+                                       {'path': 'ab', 'size': 2}],
+                           'max_total': 3})
+        self.assertEqual(result, {'files': [{'path': 'a', 'size': 1},
+                                            {'path': 'ab', 'size': 2}],
+                                  'total': 3})
+
+    def test_sizes_preserved(self):
+        payload = {'action': 'validate',
+                   'entries': [{'path': 'a', 'size': 123456789012345}],
+                   'max_total': 123456789012345}
+        self.assertEqual(dispatch(payload),
+                         {'files': [{'path': 'a', 'size': 123456789012345}],
+                          'total': 123456789012345})
+
+    def test_input_not_mutated(self):
+        payload = {'action': 'validate',
+                   'entries': [{'path': 'a/b', 'size': 1}],
+                   'max_total': 3}
+        snapshot = json.dumps(payload, sort_keys=True)
+        dispatch(payload)
+        self.assertEqual(json.dumps(payload, sort_keys=True), snapshot)
+
+    def test_rejected_input_not_mutated(self):
+        payload = {'action': 'validate',
+                   'entries': [{'path': 'a', 'size': 1},
+                               {'path': 'a', 'size': 2}],
+                   'max_total': 3}
+        snapshot = json.dumps(payload, sort_keys=True)
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+        self.assertEqual(json.dumps(payload, sort_keys=True), snapshot)
+
+    def test_existing_sizes_action(self):
+        self.assertEqual(dispatch({'action': 'sizes',
+                                    'entries': [{'path': 'x', 'size': 5},
+                                                {'path': 'y', 'size': 2}]}), 7)
+
+    def test_unknown_action(self):
+        with self.assertRaises(ValueError):
+            dispatch({'action': 'bogus', 'entries': [], 'max_total': 0})
+
+
+if __name__ == '__main__':
+    unittest.main()
