@@ -2,3 +2,26 @@
 
 def read(payload):
     return deepcopy(payload['records'].get(payload['id']))
+
+def update(payload):
+    records = deepcopy(payload['records'])
+    record_id = payload['id']
+    expected = payload['expected']
+    existing = records.get(record_id)
+    if expected is None:
+        # create-only: succeeds only when the id is absent
+        if record_id not in records:
+            records[record_id] = {'version': 1, 'data': deepcopy(payload['patch'])}
+            return {'applied': True, 'records': records,
+                    'record': deepcopy(records[record_id])}
+        return {'applied': False, 'records': records,
+                'record': deepcopy(existing) if existing is not None else None}
+    # compare-and-set: expected must equal the current version
+    if existing is not None and type(existing['version']) is int and expected == existing['version']:
+        data = deepcopy(existing['data'])
+        data.update(deepcopy(payload['patch']))
+        records[record_id] = {'version': existing['version'] + 1, 'data': data}
+        return {'applied': True, 'records': records,
+                'record': deepcopy(records[record_id])}
+    return {'applied': False, 'records': records,
+            'record': deepcopy(existing) if existing is not None else None}
