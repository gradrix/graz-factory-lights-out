@@ -0,0 +1,106 @@
+import json
+import sys
+import unittest
+
+sys.path.insert(0, '..')
+from domain import read, update
+from api import dispatch
+
+
+class UpdateTests(unittest.TestCase):
+    def test_create_when_absent(self):
+        p = {'action': 'update', 'records': {}, 'id': 'a', 'expected': None,
+             'patch': {'x': 1}}
+        self.assertEqual(dispatch(p), {
+            'applied': True,
+            'records': {'a': {'version': 1, 'data': {'x': 1}}},
+            'record': {'version': 1, 'data': {'x': 1}}})
+
+    def test_create_only_rejected_when_present(self):
+        p = {'action': 'update', 'records': {'a': {'version': 3, 'data': {'x': 1}}},
+             'id': 'a', 'expected': None, 'patch': {'y': 2}}
+        r = dispatch(p)
+        self.assertEqual(r, {'applied': False,
+                             'records': {'a': {'version': 3, 'data': {'x': 1}}},
+                             'record': {'version': 3, 'data': {'x': 1}}})
+
+    def test_match_merges_and_increments(self):
+        p = {'action': 'update', 'records': {'a': {'version': 2, 'data': {'x': 1, 'z': 9}}},
+             'id': 'a', 'expected': 2, 'patch': {'x': 5, 'y': None}}
+        r = dispatch(p)
+        self.assertEqual(r, {'applied': True,
+                             'records': {'a': {'version': 3, 'data': {'x': 5, 'z': 9, 'y': None}}},
+                             'record': {'version': 3, 'data': {'x': 5, 'z': 9, 'y': None}}})
+        # patch null values are stored, not deleted; shallow merge keeps other keys
+
+    def test_mismatch_rejected(self):
+        p = {'action': 'update', 'records': {'a': {'version': 2, 'data': {'x': 1}}},
+             'id': 'a', 'expected': 1, 'patch': {'x': 5}}
+        r = dispatch(p)
+        self.assertEqual(r, {'applied': False,
+                             'records': {'a': {'version': 2, 'data': {'x': 1}}},
+                             'record': {'version': 2, 'data': {'x': 1}}})
+
+    def test_expected_on_missing_id_rejected(self):
+        p = {'action': 'update', 'records': {}, 'id': 'a', 'expected': 0,
+             'patch': {'x': 1}}
+        r = dispatch(p)
+        self.assertEqual(r, {'applied': False, 'records': {}, 'record': None})
+
+    def test_input_payload_never_mutated(self):
+        inner = {'x': [1, 2]}
+        records = {'a': {'version': 1, 'data': inner}}
+        p = {'action': 'update', 'records': records, 'id': 'a', 'expected': 1,
+             'patch': inner}
+        r = dispatch(p)
+        self.assertEqual(records, {'a': {'version': 1, 'data': {'x': [1, 2]}}})
+        self.assertEqual(inner, {'x': [1, 2]})
+        self.assertEqual(p['patch'], {'x': [1, 2]})
+        # returned nested containers independent of input
+        self.assertIsNot(r['records']['a']['data']['x'], inner['x'])
+        # record independent of returned records
+        self.assertIsNot(r['record'], r['records']['a'])
+        self.assertIsNot(r['record']['data'], r['records']['a']['data'])
+
+    def test_read_missing_id_returns_null(self):
+        p = {'action': 'read', 'records': {}, 'id': 'a'}
+        self.assertEqual(dispatch(p), None)
+
+    def test_read_returns_independent_data(self):
+        data = {'x': [1]}
+        records = {'a': {'version': 1, 'data': data}}
+        p = {'action': 'read', 'records': records, 'id': 'a'}
+        r = dispatch(p)
+        self.assertEqual(r, {'version': 1, 'data': {'x': [1]}})
+        self.assertIsNot(r['data'], data)
+        self.assertIsNot(r['data']['x'], data['x'])
+
+    def test_unknown_action_raises_valueerror(self):
+        with self.assertRaises(ValueError):
+            dispatch({'action': 'delete', 'records': {}, 'id': 'a'})
+
+    def test_cli_update_success(self):
+        payload = {'action': 'update', 'records': {}, 'id': 'a', 'expected': None,
+                   'patch': {'x': 1}}
+        import subprocess
+        proc = subprocess.run([sys.executable, '-B', 'cli.py'],
+                              input=json.dumps(payload), capture_output=True, text=True)
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(json.loads(proc.stdout), {
+            'applied': True,
+            'records': {'a': {'version': 1, 'data': {'x': 1}}},
+            'record': {'version': 1, 'data': {'x': 1}}})
+        self.assertEqual(proc.stderr, '')
+
+    def test_cli_unknown_action_exit_2(self):
+        import subprocess
+        proc = subprocess.run([sys.executable, '-B', 'cli.py'],
+                              input=json.dumps({'action': 'nope'}),
+                              capture_output=True, text=True)
+        self.assertEqual(proc.returncode, 2)
+        self.assertNotEqual(proc.stderr, '')
+        self.assertNotIn('Traceback', proc.stderr)
+
+
+if __name__ == '__main__':
+    unittest.main()
