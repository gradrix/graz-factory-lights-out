+"""Regression tests for the domain actions, api.dispatch routing and the CLI.
+
+Run from the project root:  python tests/test_domain.py
+"""
+import json
+import os
+import subprocess
+import sys
+import unittest
+
+_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, _ROOT)
+
+from api import dispatch
+from domain import labels, order
+
+
+class OrderTest(unittest.TestCase):
+    def test_empty_nodes_returns_empty_list(self):
+        self.assertEqual(order({"action": "order", "nodes": []}), [])
+
+    def test_single_node(self):
+        self.assertEqual(order({"action": "order", "nodes": [{"id": "a", "deps": []}]}), ["a"])
+
+    def test_dependencies_placed_before_dependents(self):
+        payload = {"action": "order", "nodes": [{"id": "b", "deps": ["a"]}, {"id": "a", "deps": []}]}
+        self.assertEqual(order(payload), ["a", "b"])
+
+    def test_newly_eligible_earlier_node_outranks_later_eligible(self):
+        # After x is emitted, y (input index 1) becomes eligible and beats z (input index 2).
+        payload = {"action": "order", "nodes": [
+            {"id": "x", "deps": []},
+            {"id": "y", "deps": ["x"]},
+            {"id": "z", "deps": []},
+        ]}
+        self.assertEqual(order(payload), ["x", "y", "z"])
+
+    def test_eligible_ties_follow_input_order(self):
+        payload = {"action": "order", "nodes": [
+            {"id": "a", "deps": []},
+            {"id": "b", "deps": ["a"]},
+            {"id": "c", "deps": ["a"]},
+            {"id": "d", "deps": ["b", "c"]},
+        ]}
+        self.assertEqual(order(payload), ["a", "b", "c", "d"])
+
+    def test_two_independent_chains(self):
+        payload = {"action": "order", "nodes": [
+            {"id": "a", "deps": ["b"]},
+            {"id": "b", "deps": []},
+            {"id": "c", "deps": ["d"]},
+            {"id": "d", "deps": []},
+        ]}
+        self.assertEqual(order(payload), ["b", "a", "d", "c"])
+
+    def test_repeated_dependency_counts_as_one_edge(self):
+        payload = {"action": "order", "nodes": [
+            {"id": "a", "deps": ["b", "b", "b"]},
+            {"id": "b", "deps": []},
+        ]}
+        self.assertEqual(order(payload), ["b", "a"])
+
+    def test_repeated_dependency_does_not_hide_cycle(self):
+        payload = {"action": "order", "nodes": [
+            {"id": "a", "deps": ["b"]},
+            {"id": "b", "deps": ["a", "b"]},
+        ]}
+        with self.assertRaises(ValueError):
+            order(payload)
+
+    def test_self_dependency_is_cycle(self):
+        with self.assertRaises(ValueError):
+            order({"action": "order", "nodes": [{"id": "a", "deps": ["a"]}]})
+
+    def test_cycle_raises(self):
+        payload = {"action": "order", "nodes": [{"id": "a", "deps": ["b"]}, {"id": "b", "deps": ["a"]}]}
+        with self.assertRaises(ValueError):
+            order(payload)
+
+    def test_cycle_beside_ready_nodes_raises(self):
+        payload = {"action": "order", "nodes": [
+            {"id": "a", "deps": []},
+            {"id": "b", "deps": ["c"]},
+            {"id": "c", "deps": ["b"]},
+        ]}
+        with self.assertRaises(ValueError):
+            order(payload)
+
+    def test_unknown_dependency_raises(self):
+        payload = {"action": "order", "nodes": [{"id": "a", "deps": ["nope"]}]}
+        with self.assertRaises(ValueError):
+            order(payload)
+
+    def test_unknown_dependency_raises_even_when_cycle_present(self):
+        payload = {"action": "order", "nodes": [{"id": "a", "deps": ["b", "ghost"]}, {"id": "b", "deps": ["a"]}]}
+        with self.assertRaises(ValueError):
+            order(payload)
+
+    def test_duplicate_id_raises(self):
+        payload = {"action": "order", "nodes": [{"id": "a", "deps": []}, {"id": "a", "deps": []}]}
+        with self.assertRaises(ValueError):
+            order(payload)
+
+    def test_never_mutates_accepted_input(self):
+        payload = {"action": "order", "nodes": [{"id": "a", "deps": ["b", "b"]}, {"id": "b", "deps": []}]}
+        snapshot = json.loads(json.dumps(payload))
+        order(payload)
+        self.assertEqual(payload, snapshot)
+
+    def test_never_mutates_rejected_input(self):
+        payload = {"action": "order", "nodes": [{"id": "a", "deps": ["a"]}]}
+        snapshot = json.loads(json.dumps(payload))
+        with self.assertRaises(ValueError):
+            order(payload)
+        self.assertEqual(payload, snapshot)
+
+    def test_never_mutates_rejected_unknown_input(self):
+        payload = {"action": "order", "nodes": [{"id": "a", "deps": ["ghost"]}]}
+        snapshot = json.loads(json.dumps(payload))
+        with self.assertRaises(ValueError):
+            order(payload)
+        self.assertEqual(payload, snapshot)
+
+    def test_never_mutates_rejected_duplicate_input(self):
+        payload = {"action": "order", "nodes": [{"id": "a", "deps": []}, {"id": "a", "deps": []}]}
+        snapshot = json.loads(json.dumps(payload))
+        with self.assertRaises(ValueError):
+            order(payload)
+        self.assertEqual(payload, snapshot)
+
+    def test_result_is_a_fresh_list(self):
+        payload = {"action": "order", "nodes": [{"id": "a", "deps": []}]}
+        first = order(payload)
+        second = order(payload)
+        self.assertEqual(first, second)
+        self.assertIsNot(first, second)
+
+    def test_dispatch_routes_order(self):
+        payload = {"action": "order", "nodes": [{"id": "a", "deps": []}]}
+        self.assertEqual(dispatch(payload), ["a"])
+
+    def test_labels_unchanged(self):
+        payload = {"action": "labels", "nodes": [{"id": "q", "deps": ["ignored"]}]}
+        self.assertEqual(labels(payload), ["q"])
+        self.assertEqual(dispatch(payload), ["q"])
+
+    def test_labels_still_ignores_deps_and_errors(self):
+        payload = {"action": "labels", "nodes": [{"id": "a", "deps": ["a"]}, {"id": "a", "deps": []}]}
+        self.assertEqual(dispatch(payload), ["a", "a"])
+
+    def test_unknown_action_still_raises(self):
+        with self.assertRaises(ValueError):
+            dispatch({"action": "nope", "nodes": []})
+
+    def test_cli_success(self):
+        payload = {"action": "order", "nodes": [
+            {"id": "x", "deps": []},
+            {"id": "y", "deps": ["x"]},
+            {"id": "z", "deps": []},
+        ]}
+        proc = subprocess.run(["python", os.path.join(_ROOT, "cli.py")],
+                              input=json.dumps(payload), capture_output=True, text=True)
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(proc.stderr, "")
+        self.assertEqual(json.loads(proc.stdout), ["x", "y", "z"])
+
+    def test_cli_error_exit_2_with_stderr_and_no_traceback(self):
+        payload = {"action": "order", "nodes": [{"id": "a", "deps": ["a"]}]}
+        proc = subprocess.run(["python", os.path.join(_ROOT, "cli.py")],
+                              input=json.dumps(payload), capture_output=True, text=True)
+        self.assertEqual(proc.returncode, 2)
+        self.assertEqual(proc.stdout, "")
+        self.assertNotEqual(proc.stderr, "")
+        self.assertNotIn("Traceback", proc.stderr)
+
+    def test_cli_utf8_labels(self):
+        payload = {"action": "order", "nodes": [{"id": "α", "deps": []}, {"id": "β", "deps": ["α"]}]}
+        proc = subprocess.run(["python", os.path.join(_ROOT, "cli.py")],
+                              input=json.dumps(payload, ensure_ascii=False),
+                              capture_output=True, text=True, encoding="utf-8")
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(json.loads(proc.stdout), ["α", "β"])
+
+
+if __name__ == "__main__":
+    unittest.main()
