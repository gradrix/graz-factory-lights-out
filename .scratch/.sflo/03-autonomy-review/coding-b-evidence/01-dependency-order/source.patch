 def labels(payload):
     return [node['id'] for node in payload['nodes']]
+
+
+def order(payload):
+    """Topologically order payload['nodes'].
+
+    Each node is {'id': nonempty string, 'deps': list of node ids}.
+    Duplicate ids or a dependency naming an unknown id raise ValueError.
+    Repeated dependency entries count as one edge.
+    At each step the eligible node with the smallest index in the original
+    nodes list is emitted; a cycle (including a self-dependency) raises
+    ValueError. The payload is never mutated.
+    """
+    nodes = payload['nodes']
+    ids = []
+    deps = {}
+    for node in nodes:
+        node_id = node['id']
+        if node_id in deps:
+            raise ValueError("duplicate node id: " + str(node_id))
+        deps[node_id] = set(node['deps'])
+        ids.append(node_id)
+    id_set = set(ids)
+    for node_id in ids:
+        unknown = sorted(dep for dep in deps[node_id] if dep not in id_set)
+        if unknown:
+            raise ValueError("unknown dependency: " + str(unknown[0]))
+    remaining = set(ids)
+    result = []
+    while remaining:
+        eligible = [nid for nid in ids if nid in remaining and not (deps[nid] & remaining)]
+        if not eligible:
+            raise ValueError("cycle detected among node ids: " + ", ".join(sorted(remaining)))
+        chosen = eligible[0]
+        remaining.discard(chosen)
+        result.append(chosen)
+    return result
