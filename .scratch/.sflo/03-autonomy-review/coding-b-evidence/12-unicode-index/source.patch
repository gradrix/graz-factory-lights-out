+import json
+import unittest
+from api import dispatch
+
+
+class IndexTests(unittest.TestCase):
+    def test_ascii(self):
+        payload = {"action": "index", "text": "abc", "byte_offsets": [0, 1, 2, 3]}
+        result = dispatch(payload)
+        self.assertEqual(result, {"byte_length": 3, "char_to_byte": [0, 1, 2, 3], "byte_to_char": [0, 1, 2, 3]})
+
+    def test_multibyte(self):
+        payload = {"action": "index", "text": "aé€", "byte_offsets": [0, 1, 3, 6]}
+        result = dispatch(payload)
+        self.assertEqual(result, {"byte_length": 6, "char_to_byte": [0, 1, 3, 6], "byte_to_char": [0, 1, 2, 3]})
+
+    def test_emoji(self):
+        payload = {"action": "index", "text": "😀x", "byte_offsets": [0, 4, 5]}
+        result = dispatch(payload)
+        self.assertEqual(result, {"byte_length": 5, "char_to_byte": [0, 4, 5], "byte_to_char": [0, 1, 2]})
+
+    def test_combining(self):
+        payload = {"action": "index", "text": "A\U0001F600\u00e9\u0301", "byte_offsets": [9, 0, 1, 5, 7, 1]}
+        result = dispatch(payload)
+        self.assertEqual(result, {"byte_length": 9, "char_to_byte": [0, 1, 5, 7, 9], "byte_to_char": [4, 0, 1, 2, 3, 1]})
+
+    def test_empty_text(self):
+        payload = {"action": "index", "text": "", "byte_offsets": [0]}
+        result = dispatch(payload)
+        self.assertEqual(result, {"byte_length": 0, "char_to_byte": [0], "byte_to_char": [0]})
+
+    def test_empty_offsets(self):
+        payload = {"action": "index", "text": "abc", "byte_offsets": []}
+        result = dispatch(payload)
+        self.assertEqual(result, {"byte_length": 3, "char_to_byte": [0, 1, 2, 3], "byte_to_char": []})
+
+    def test_repeated_offsets(self):
+        payload = {"action": "index", "text": "aé", "byte_offsets": [0, 1, 1, 3, 3]}
+        result = dispatch(payload)
+        self.assertEqual(result["byte_to_char"], [0, 1, 1, 2, 2])
+
+    def test_negative_offset(self):
+        payload = {"action": "index", "text": "abc", "byte_offsets": [-1]}
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+
+    def test_beyond_length(self):
+        payload = {"action": "index", "text": "aé", "byte_offsets": [4]}
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+
+    def test_inside_multibyte(self):
+        payload = {"action": "index", "text": "aé€", "byte_offsets": [2]}
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+
+    def test_length_action_preserved(self):
+        payload = {"action": "length", "text": "aé😀"}
+        self.assertEqual(dispatch(payload), 3)
+
+    def test_unknown_action(self):
+        payload = {"action": "nope", "text": "abc", "byte_offsets": []}
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+
+    def test_input_not_mutated(self):
+        payload = {"action": "index", "text": "aé", "byte_offsets": [0, 3, 3]}
+        original = json.loads(json.dumps(payload))
+        dispatch(payload)
+        self.assertEqual(payload, original)
+
+    def test_rejected_input_not_mutated(self):
+        payload = {"action": "index", "text": "aé", "byte_offsets": [2]}
+        original = json.loads(json.dumps(payload))
+        with self.assertRaises(ValueError):
+            dispatch(payload)
+        self.assertEqual(payload, original)
+
+
+if __name__ == "__main__":
+    unittest.main()
