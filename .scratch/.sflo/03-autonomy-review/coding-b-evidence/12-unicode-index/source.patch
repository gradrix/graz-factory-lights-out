@@ -1,2 +1,25 @@
 def length(payload):
     return len(payload['text'])
+
+def index(payload):
+    text = payload['text']
+    encoded = text.encode('utf-8')
+    byte_length = len(encoded)
+    char_to_byte = [0] * (len(text) + 1)
+    offset = 0
+    for i, ch in enumerate(text):
+        char_to_byte[i] = offset
+        offset += len(ch.encode('utf-8'))
+    char_to_byte[len(text)] = offset
+    boundary_to_char = {byte: char for char, byte in enumerate(char_to_byte)}
+    byte_to_char = []
+    for requested in payload['byte_offsets']:
+        if requested < 0 or requested > byte_length:
+            raise ValueError("byte offset out of range: " + str(requested))
+        if requested == byte_length:
+            byte_to_char.append(len(text))
+        elif requested in boundary_to_char:
+            byte_to_char.append(boundary_to_char[requested])
+        else:
+            raise ValueError("byte offset inside a multi-byte code point: " + str(requested))
+    return {'byte_length': byte_length, 'char_to_byte': char_to_byte, 'byte_to_char': byte_to_char}
