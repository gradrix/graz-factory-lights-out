    "source": {
      "schema_version": 1,
      "files": {
        "main.py": "import json, sys\n\ndef parse_version(s):\n    parts = s.split('.')\n    nums = []\n    for p in parts:\n        nums.append(int(p))\n    return nums\n\ndef compare_versions(a, b):\n    pa = parse_version(a)\n    pb = parse_version(b)\n    max_len = max(len(pa), len(pb))\n    for i in range(max_len):\n        va = pa[i] if i < len(pa) else 0\n        vb = pb[i] if i < len(pb) else 0\n        if va < vb:\n            return -1\n        if va > vb:\n            return 1\n    return 0\n\ndef main():\n    x = json.load(sys.stdin)\n    result = sorted(x, key=lambda s: parse_version(s))\n    print(json.dumps(result, sort_keys=True))\n\nif __name__ == '__main__':\n    main()\n"
      }
    },
